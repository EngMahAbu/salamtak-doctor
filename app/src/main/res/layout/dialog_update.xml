<?xml version="1.0" encoding="utf-8"?>
<layout>

    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="@dimen/_250sdp"
        android:layout_height="@dimen/_220sdp"
        android:background="@drawable/bg_corner_white">

        <TextView
            android:layout_width="@dimen/_250sdp"
            android:layout_height="@dimen/_220sdp"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/bg_corner_white"
            />


        <ImageView
            android:id="@+id/confirm_iv"
            android:layout_width="@dimen/_80sdp"
            android:layout_height="@dimen/_40sdp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/_20sdp"
            android:src="@drawable/ic_dialog_confirmed"
            />

        <TextView
            android:id="@+id/dialog_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/confirm_iv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/_20sdp"
            android:textSize="@dimen/_22ssp"
            android:fontFamily="@font/my_font_bold"
            android:textColor="@color/sky_main"
            android:text="@string/great"
            />

        <TextView
            android:id="@+id/dialog_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/dialog_header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/_15sdp"
            android:textSize="@dimen/_16ssp"
            android:textColor="@color/head_color"
            android:text="@string/update_will_be_reviewed_within_24_48_hours"
            android:fontFamily="@font/my_font_regular"
            android:layout_marginHorizontal="@dimen/_25sdp"
            android:gravity="center"
            />

        <TextView
            android:id="@+id/dialog_ok"
            android:layout_width="@dimen/_200sdp"
            android:layout_height="@dimen/_30sdp"
            app:layout_constraintTop_toBottomOf="@id/dialog_txt"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/_10sdp"
            android:textSize="@dimen/_18ssp"
            android:fontFamily="@font/my_font_regular"
            android:textColor="@color/head_color"
            android:text="@string/done"
            android:background="@drawable/otp_border"
            android:layout_marginHorizontal="@dimen/_25sdp"
            android:gravity="center"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>