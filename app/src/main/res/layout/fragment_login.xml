<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_color_gray"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/new_theme_color">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1.0">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <include
                    android:id="@+id/toolbar"
                    layout="@layout/authentication_toolbar"
                    android:visibility="gone" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_percent=".12" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline_half"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_percent="0.74" />

                <TextView
                    android:id="@+id/sign_in_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:fontFamily="@font/avenir_bold"
                    android:text="@string/log_in"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_18ssp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_help"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:background="@drawable/bg_btn_blue"
                    android:backgroundTint="#E8E8FD"
                    android:drawableLeft="@drawable/frame__2_"
                    android:drawablePadding="@dimen/_6sdp"
                    android:elevation="@dimen/_2sdp"
                    android:fontFamily="@font/avenir_regular"
                    android:paddingHorizontal="@dimen/_6sdp"
                    android:paddingVertical="@dimen/_6sdp"
                    android:text="@string/help"
                    android:textColor="@color/new_themeBlue_color"
                    android:textSize="@dimen/_10ssp"
                    app:layout_constraintBottom_toBottomOf="@+id/sign_in_tv"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/sign_in_tv" />

                <ImageView
                    android:id="@+id/imageView2"
                    android:layout_width="190dp"
                    android:layout_height="80dp"
                    android:adjustViewBounds="true"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:src="@drawable/ic_new_logo"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/guideline" />

                <TextView
                    android:id="@+id/Login_with"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_13sdp"
                    android:fontFamily="@font/sf_pro_display_semibold"
                    android:text="@string/login_with"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_10ssp"
                    app:layout_constraintStart_toStartOf="@id/password_layout"
                    app:layout_constraintTop_toBottomOf="@id/imageView2" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/radiogroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="15dp"
                    app:layout_constraintTop_toBottomOf="@+id/Login_with"
                    app:layout_constraintStart_toStartOf="@+id/Login_with"
                    app:layout_constraintEnd_toEndOf="parent">
                    <RadioGroup
                        android:id="@+id/radio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/radio_english"
                            android:layout_width="165dp"
                            android:layout_height="50dp"
                            android:padding="3dp"
                            android:background="@drawable/bg_choose_account_radiobtn"
                            android:layout_marginBottom="5dp"
                            android:text="@string/doctoraccount"
                            android:layout_marginStart="3dp"
                            android:layout_marginEnd="5dp"
                            android:layout_marginTop="5dp"
                            android:checked="true"
                            android:buttonTint="@color/green"
                            android:textColor="@color/text_gray6"
                            android:textSize="12sp"
                            />

                        <RadioButton
                            android:id="@+id/radio_arabic"
                            android:layout_width="165dp"
                            android:layout_height="50dp"
                            android:text="@string/polyclinicaccount"
                            android:textSize="12sp"
                            android:layout_marginEnd="10dp"
                            android:layout_marginStart="10dp"
                            android:layout_marginTop="5dp"
                            android:padding="3dp"
                            android:buttonTint="#A5ABBF"
                            android:background="@drawable/bg_choose_account_unselected"
                            android:textColor="@color/black"
                            />
                    </RadioGroup>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/mCard_phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    android:layout_marginTop="@dimen/_12sdp"
                    app:cardCornerRadius="@dimen/_6sdp"
                    app:cardElevation="@dimen/_2sdp"
                    app:layout_constraintTop_toBottomOf="@+id/radiogroup"
                    app:layout_goneMarginTop="@dimen/_30sdp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/filledTextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/phone_numbers"
                        app:boxBackgroundMode="none"
                        android:padding="2dp"
                        app:hintTextColor="@color/gray"
                        app:boxStrokeColor="@color/colorPrimary">

                        <!--this is the actual edit text which takes the input-->
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/phone_et"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/white"
                            android:inputType="phone"
                            android:paddingBottom="2dp"
                            android:maxLength="11"
                            android:maxLines="1"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!--                    <EditText-->
                    <!--                        android:id="@+id/phone_et"-->
                    <!--                        android:layout_width="match_parent"-->
                    <!--                        android:layout_height="@dimen/_40sdp"-->
                    <!--                        android:alpha=".7"-->
                    <!--                        android:hint="@string/hint_number"-->
                    <!--                        android:inputType="phone"-->
                    <!--                        android:maxLength="11"-->
                    <!--                        android:maxLines="1"-->
                    <!--                        android:paddingLeft="@dimen/_15sdp"-->
                    <!--                        android:singleLine="true" />-->
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/password_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    android:layout_marginTop="@dimen/_10sdp"
                    app:cardCornerRadius="@dimen/_6sdp"
                    app:cardElevation="@dimen/_2sdp"
                    app:layout_constraintTop_toBottomOf="@+id/error_phone"
                    tools:layout_editor_absoluteX="21dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/enter_passwords"
                        app:boxStrokeColor="@color/colorPrimary"
                        app:hintTextColor="@color/gray"
                        app:passwordToggleEnabled="true"
                        app:boxBackgroundMode="none"
                        android:padding="2dp"
                        app:passwordToggleTint="@color/sky_main">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/password_et"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/white"
                            android:paddingBottom="2dp"
                            android:inputType="textPassword" />

                    </com.google.android.material.textfield.TextInputLayout>

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/error_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_6sdp"
                    android:text="@string/incorrect_phone_number"
                    android:textColor="@color/red"
                    android:textSize="@dimen/_8ssp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="@+id/mCard_phone"
                    app:layout_constraintTop_toBottomOf="@id/mCard_phone" />

                <ImageView
                    android:id="@+id/iv_phoneError"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:layout_marginEnd="@dimen/_16sdp"
                    android:elevation="@dimen/_10sdp"
                    android:src="@drawable/ic_error"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@+id/mCard_phone"
                    app:layout_constraintEnd_toEndOf="@+id/mCard_phone"
                    app:layout_constraintTop_toTopOf="@+id/mCard_phone"/>

                <ImageView
                    android:id="@+id/iv_passerror"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:layout_marginEnd="@dimen/_30sdp"
                    android:elevation="4dp"
                    android:src="@drawable/ic_error"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@+id/password_layout"
                    app:layout_constraintEnd_toEndOf="@+id/password_layout"
                    app:layout_constraintTop_toTopOf="@+id/password_layout" />

                <TextView
                    android:id="@+id/error_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_3sdp"
                    android:text="@string/password_required"
                    android:textColor="@color/red"
                    android:textSize="@dimen/_8ssp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="@+id/password_layout"
                    app:layout_constraintTop_toBottomOf="@id/password_layout" />



                <TextView
                    android:id="@+id/forget_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_13sdp"
                    android:fontFamily="@font/sf_pro_display_semibold"
                    android:text="@string/forget_password"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_10ssp"
                    app:layout_constraintStart_toStartOf="@id/password_layout"
                    app:layout_constraintTop_toBottomOf="@id/error_password" />

                <!--                <com.rilixtech.CountryCodePicker-->
                <!--                    android:id="@+id/county_code"-->
                <!--                    android:layout_width="wrap_content"-->
                <!--                    android:layout_height="wrap_content"-->
                <!--                    android:layout_marginStart="@dimen/_5sdp"-->
                <!--                    android:layoutDirection="ltr"-->
                <!--                    android:textDirection="firstStrongLtr"-->
                <!--                    android:visibility="gone"-->
                <!--                    app:ccp_arrowSize="@dimen/_15sdp"-->
                <!--                    app:ccp_clickable="false"-->
                <!--                    app:ccp_countryPreference="@string/country_egypt_code"-->
                <!--                    app:ccp_hideNameCode="true"-->
                <!--                    app:ccp_setCountryByTimeZone="true"-->
                <!--                    app:ccp_textSize="@dimen/_11ssp"-->
                <!--                    app:layout_constraintBottom_toBottomOf="@id/phone_et"-->
                <!--                    app:layout_constraintLeft_toLeftOf="@id/phone_et"-->
                <!--                    app:layout_constraintTop_toTopOf="@id/phone_et" />-->

                <!--                <View-->
                <!--                    android:layout_width="1.5dp"-->
                <!--                    android:layout_height="0dp"-->
                <!--                    android:layout_marginHorizontal="@dimen/_3sdp"-->
                <!--                    android:background="@color/gray_60"-->
                <!--                    android:visibility="gone"-->
                <!--                    app:layout_constraintBottom_toBottomOf="@id/county_code"-->
                <!--                    app:layout_constraintLeft_toRightOf="@id/county_code"-->
                <!--                    app:layout_constraintTop_toTopOf="@id/county_code" />-->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/to_login_btn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_50sdp"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    android:layout_marginTop="@dimen/_17sdp"
                    android:backgroundTint="@color/new_themeBlue_color"
                    android:fontFamily="@font/avenirs_semibold"
                    android:text="@string/sign_in"
                    android:textAllCaps="false"
                    android:textSize="@dimen/_14ssp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/forget_password" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/_10sdp"
                    app:layout_constraintTop_toBottomOf="@id/to_login_btn" />

                <TextView
                    android:id="@+id/donot_have"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="24dp"
                    android:fontFamily="@font/avenir_regular"
                    android:gravity="center"
                    android:text="@string/don_t_have_an_account"
                    android:textColor="@color/head_color"
                    android:textSize="@dimen/_12ssp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/create_new"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/to_login_btn" />

                <TextView
                    android:id="@+id/create_new"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/avenir_regular"
                    android:gravity="center"
                    android:text="@string/signup"
                    android:textColor="@color/sky_main"
                    android:textSize="@dimen/_12ssp"
                    app:layout_constraintBottom_toBottomOf="@+id/donot_have"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/donot_have"
                    app:layout_constraintTop_toTopOf="@+id/donot_have" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/layoutBottomsheetpersistant"
        layout="@layout/layout_bottomsheet_register"
        android:visibility="visible"
        />

</androidx.coordinatorlayout.widget.CoordinatorLayout>