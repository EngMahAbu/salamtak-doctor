<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:custom="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_round_bg">

    <TextView
        android:id="@+id/statistics_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/avenirs_semibold"
        android:text="@string/all_clinics"
        android:layout_gravity="center"
        android:textColor="@color/black"
        android:textSize="@dimen/_14ssp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/all_select_btn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_46sdp"
        android:text="@string/all_clinics"
        android:textAllCaps="false"
        android:visibility="gone"
        android:gravity="center_vertical"
        android:fontFamily="@font/avenirs_semibold"
        android:drawableEnd="@drawable/click_background"
        custom:cornerRadius="@dimen/_6sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_6sdp"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:backgroundTint="@color/new_themeBlue_color"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/clinics_home_rv"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_200sdp"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        tools:itemCount="10"
        tools:listitem="@layout/item_home_clinic" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/done_btn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_46sdp"
        android:text="@string/dones"
        android:textAllCaps="false"
        android:fontFamily="@font/avenirs_semibold"
        custom:cornerRadius="@dimen/_6sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_6sdp"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:backgroundTint="@color/new_themeBlue_color"/>

</LinearLayout>