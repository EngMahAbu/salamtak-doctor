<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_sheet_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bottom_sheet_round_bg"
        android:elevation="@dimen/_5sdp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">


        <TextView
            android:id="@+id/header_title_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_18sdp"
            android:fontFamily="@font/avenir_bold"
            android:text="@string/appointments_filter"
            android:textColor="@color/title_color_black"
            android:textSize="@dimen/_14ssp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/consultation_type_txt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_19sdp"
            android:fontFamily="@font/avenir_bold"
            android:text="@string/consultation_type"
            android:textColor="@color/title_color_black"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintEnd_toEndOf="@id/end_guid_line"
            app:layout_constraintStart_toStartOf="@id/start_guid_line"
            app:layout_constraintTop_toBottomOf="@id/header_title_txt" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/statics_rv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="@+id/end_guid_line"
            app:layout_constraintStart_toStartOf="@+id/start_guid_line"
            app:layout_constraintTop_toBottomOf="@id/consultation_type_txt"
            tools:itemCount="1"
            tools:listitem="@layout/item_new_spinner" />


        <TextView
            android:id="@+id/desc_consultation_type_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/my_font_medium"
            android:visibility="gone"
            android:text="Home Visit , Clinic Visit ,  Video Call"
            android:textColor="@color/text_gray3"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@id/start_guid_line"
            app:layout_constraintTop_toBottomOf="@id/consultation_type_txt" />

        <View
            android:id="@+id/v_h"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:background="@color/gray_light_color"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/desc_consultation_type_txt" />

        <TextView
            android:id="@+id/dates_txt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawableEnd="@drawable/ic_next_right"
            android:fontFamily="@font/my_font_medium"
            android:text="@string/dates"
            android:visibility="gone"
            android:textColor="@color/title_color_black"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="@id/end_guid_line"
            app:layout_constraintStart_toStartOf="@id/start_guid_line"
            app:layout_constraintTop_toBottomOf="@id/v_h" />

        <TextView
            android:id="@+id/desc_dates_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/my_font_medium"
            android:text="20 / 03 / 2022 to 27 / 03 / 2022"
            android:textColor="@color/text_gray3"
            android:visibility="gone"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@id/start_guid_line"
            app:layout_constraintTop_toBottomOf="@id/dates_txt" />

        <View
            android:id="@+id/v_h2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:background="@color/gray_light_color"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/desc_dates_txt" />

        <TextView
            android:id="@+id/clinic_txt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_19sdp"
            android:fontFamily="@font/my_font_bold"
            android:text="@string/clinic"
            android:visibility="gone"
            android:textColor="@color/title_color_black"
            android:textSize="@dimen/_12sdp"
            app:layout_constraintEnd_toEndOf="@id/end_guid_line"
            app:layout_constraintStart_toStartOf="@id/start_guid_line"
            app:layout_constraintTop_toBottomOf="@+id/statics_rv"/>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/choices_rv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="@dimen/_18sdp"
            app:layout_constraintEnd_toEndOf="@+id/end_guid_line"
            app:layout_constraintStart_toStartOf="@+id/start_guid_line"
            app:layout_constraintTop_toBottomOf="@id/clinic_txt"
            tools:itemCount="1"
            tools:listitem="@layout/item_home_clinic" />

        <TextView
            android:id="@+id/desc_clinic_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/my_font_medium"
            android:text="Clinic 1 , Clinic 2"
            android:visibility="gone"
            android:textColor="@color/text_gray3"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@id/start_guid_line"
            app:layout_constraintTop_toBottomOf="@id/clinic_txt" />

        <View
            android:id="@+id/v_h3"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            android:background="@color/gray_light_color"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/desc_clinic_txt" />

        <EditText
            android:id="@+id/patient_name_txt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:fontFamily="@font/my_font_medium"
            android:hint="@string/patient_name"
            android:textColor="@color/title_color_black"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="@id/end_guid_line"
            app:layout_constraintStart_toStartOf="@id/start_guid_line"
            app:layout_constraintTop_toBottomOf="@id/v_h3" />

        <TextView
            android:id="@+id/apply_btn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_44sdp"
            android:layout_margin="@dimen/_12sdp"
            android:background="@drawable/bg_btn_blue"
            android:fontFamily="@font/avenir_medium"
            android:gravity="center"
            android:text="Done"
            android:visibility="gone"
            android:textColor="@color/white"
            android:textSize="@dimen/_10ssp"
            app:layout_constraintBottom_toBottomOf="parent" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/start_guid_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.05" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/end_guid_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.95" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>