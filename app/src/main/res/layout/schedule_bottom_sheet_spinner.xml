<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:behavior_peekHeight="@dimen/_100sdp"
        android:backgroundTint="@color/white"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <RelativeLayout
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
            android:layout_width="match_parent"
            android:id="@+id/bottom_sheet_spinner"
            android:orientation="vertical"
            android:elevation="@dimen/_5sdp"
            android:layout_height="@dimen/_360sdp">


            <View
                android:id="@+id/slide_view"
                android:layout_width="@dimen/_99sdp"
                android:layout_height="@dimen/_3sdp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                android:background="@color/gray_60"
                android:layout_centerHorizontal="true"
                android:visibility="gone"
                android:layout_marginTop="@dimen/_20sdp"
                android:elevation="@dimen/_5sdp"/>

            <TextView
                android:id="@+id/header_title_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/slide_view"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_centerHorizontal="true"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_19sdp"
                android:textSize="@dimen/_12ssp"
                android:fontFamily="@font/avenir_bold"
                android:textColor="@color/title_color_black"
                android:text="@string/nationality"
                />

            <LinearLayout
                android:id="@+id/ll_recyclerview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@id/submit_btn"
                android:layout_below="@+id/header_title_txt"
                android:layout_marginBottom="@dimen/_12sdp"
                app:layout_constraintTop_toBottomOf="@id/slide_view"
                android:orientation="vertical">


                <androidx.appcompat.widget.SearchView
                    android:id="@+id/search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/otp_border"
                    android:backgroundTint="#fafafa"
                    android:visibility="gone"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:elevation="@dimen/_4sdp"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    app:layout_constraintTop_toBottomOf="@id/header_title_txt">

                </androidx.appcompat.widget.SearchView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/services_rv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/_12sdp"
                    android:visibility="visible"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    android:orientation="vertical" />
            </LinearLayout>


            <TextView
                android:id="@+id/no_country_found"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_result_found"
                android:gravity="center"
                android:visibility="gone"
                android:fontFamily="@font/my_font_semibold"
                android:layout_margin="@dimen/_12sdp"
                app:layout_constraintBottom_toTopOf="@id/submit_btn"
                app:layout_constraintTop_toBottomOf="@+id/ll_recyclerview"
                tools:itemCount="3"
                tools:layout_editor_absoluteX="12dp" />

            <TextView
                android:id="@+id/submit_btn"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_40sdp"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_marginEnd="@dimen/_12sdp"
                android:layout_marginBottom="@dimen/_12sdp"
                android:background="@drawable/bg_btn_blue"
                android:fontFamily="@font/my_font_semibold"
                android:gravity="center"
                android:text="@string/done"
                android:layout_alignParentBottom="true"
                android:textColor="@color/white"
                android:textSize="@dimen/_12ssp"
                app:layout_constraintBottom_toBottomOf="parent" />


        </RelativeLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</layout>