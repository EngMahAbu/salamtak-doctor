    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_6sdp"
        app:cardElevation="@dimen/_1sdp"
        app:cardCornerRadius="@dimen/_6sdp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/doctor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:fontFamily="@font/avenirs_semibold"
                android:gravity="center"
                android:maxLength="10"
                android:padding="@dimen/_6sdp"
                android:text=""
                android:textColor="@color/black"
                android:textSize="@dimen/_12ssp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/doctor_name_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/avenirs_semibold"
                android:gravity="center"
                android:maxLength="10"
                android:padding="@dimen/_3sdp"
                android:textColor="@color/black"
                android:textSize="@dimen/_12ssp"
                app:layout_constraintBottom_toBottomOf="@+id/doctor"
                app:layout_constraintStart_toEndOf="@+id/doctor"
                app:layout_constraintTop_toTopOf="@+id/doctor"
                tools:text="Mohamed" />

            <ImageView
                android:id="@+id/edit_patient_account_tv"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_column="7"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:src="@drawable/edit"
                app:layout_constraintBottom_toBottomOf="@+id/delete_patient_account_tv"
                app:layout_constraintEnd_toStartOf="@+id/delete_patient_account_tv"
                app:layout_constraintTop_toTopOf="@+id/delete_patient_account_tv" />

            <ImageView
                android:id="@+id/delete_patient_account_tv"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_column="8"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:src="@drawable/delete"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@+id/doctor_name_tv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/doctor_name_tv" />

            <LinearLayout
                android:id="@+id/linearLayout2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_6sdp"
                app:layout_constraintStart_toStartOf="@+id/doctor"
                app:layout_constraintTop_toBottomOf="@+id/doctor_name_tv">


                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="1,2,3,4">

                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:layout_column="1"
                            android:gravity="start"
                            android:text="@string/datess"
                            android:textColor="@color/hint_color"
                            android:textSize="@dimen/_12ssp" />


                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:layout_column="2"
                            android:gravity="center"
                            android:text="@string/servicess"
                            android:textColor="@color/hint_color"
                            android:textSize="@dimen/_12ssp" />

                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:layout_column="3"
                            android:gravity="center"
                            android:text="@string/fee"
                            android:textColor="@color/hint_color"
                            android:textSize="@dimen/_12ssp" />

                        <TextView
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:layout_column="4"
                            android:gravity="center"
                            android:text="@string/paids"
                            android:textColor="@color/hint_color"
                            android:textSize="@dimen/_12ssp" />

                    </TableRow>

                </TableLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_6sdp"
                app:layout_constraintStart_toStartOf="@+id/linearLayout2"
                app:layout_constraintTop_toBottomOf="@+id/linearLayout2">


                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="1,2,3,4">

                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <TextView
                            android:id="@+id/date_tv"
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:layout_column="1"
                            android:gravity="start"
                            android:lines="1"
                            android:textColor="@color/black"
                            android:textSize="10sp"
                            tools:text="22/07/2020" />


                        <TextView
                            android:id="@+id/service_tv"
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:layout_column="2"
                            android:gravity="center_horizontal"
                            android:textColor="@color/black"
                            android:textSize="10sp"
                            tools:text="limpe tets" />

                        <TextView
                            android:id="@+id/fee_tv"
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:layout_column="3"
                            android:gravity="center_horizontal"
                            android:textColor="@color/black"
                            android:textSize="10sp"
                            tools:text="300" />

                        <TextView
                            android:id="@+id/paid_tv"
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:layout_column="4"
                            android:gravity="center_horizontal"
                            android:textColor="@color/black"
                            android:textSize="10sp"
                            tools:text="100" />

                    </TableRow>

                </TableLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:background="@drawable/balance_bg"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_6sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/linearLayout"
                app:layout_constraintTop_toBottomOf="@+id/linearLayout">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:padding="@dimen/_6sdp"
                    android:text="@string/balance"
                    android:textColor="@color/head_color"
                    android:textSize="@dimen/_12ssp" />

                <TextView
                    android:id="@+id/balance_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:padding="@dimen/_6sdp"
                    android:textColor="@color/red"
                    android:textSize="@dimen/_12ssp"
                    tools:text="100" />
            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>



</layout>