<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="vaction"
            type="com.salamtak.domain.entities.response.VactionData" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_6sdp"
        app:cardElevation="@dimen/_1sdp"
        app:cardCornerRadius="@dimen/_6sdp">

        <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/_5sdp"
        >

            <TextView
                    android:id="@+id/vaction_name_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_column="1"
                    android:gravity="center"
                    android:lines="1"
                    android:visibility="gone"
                    android:text="@{vaction.vacationName}"
                    tools:text="Sanai Leberation day"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:fontFamily="@font/avenir_bold"
                    android:textColor="@color/black"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:textSize="@dimen/_12ssp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                    android:id="@+id/edit_patient_account_tv"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_column="7"
                    android:layout_marginEnd="4dp"
                    android:gravity="center"
                    android:layout_marginTop="@dimen/_15sdp"
                    android:visibility="visible"
                    android:src="@drawable/edit"
                    app:layout_constraintBottom_toBottomOf="@+id/delete_patient_account_tv"
                    app:layout_constraintEnd_toStartOf="@+id/delete_patient_account_tv"
                    app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                    android:id="@+id/delete_patient_account_tv"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_column="8"
                    android:layout_marginEnd="3dp"
                    android:gravity="center"
                    android:src="@drawable/delete"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/edit_patient_account_tv" />


            <ImageView
                    android:id="@+id/calendar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/calendar"
                    android:layout_marginTop="@dimen/_10sdp"
                    app:layout_constraintStart_toStartOf="@+id/vaction_name_tv"
                    app:layout_constraintTop_toBottomOf="@+id/vaction_name_tv" />

            <TextView
                    android:id="@+id/tv_vacationissuedate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:lines="1"
                    android:text="@string/vacation_issue_date"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    app:layout_constraintStart_toEndOf="@+id/calendar"
                    app:layout_constraintTop_toTopOf="parent"
            />

            <TextView
                    android:id="@+id/vaction_to_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:lines="1"
                    android:textColor="@color/blue"
                    android:textSize="9sp"
                    android:layout_marginTop="@dimen/_5sdp"
                    app:layout_constraintBottom_toBottomOf="@+id/calendar"
                    app:layout_constraintStart_toEndOf="@+id/calendar"
                    app:layout_constraintTop_toBottomOf="@+id/tv_vacationissuedate"
                    tools:text="Tue, 08 Nov 2022 - Wed, 16 Nov 2022" />

            <androidx.recyclerview.widget.RecyclerView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:layout_marginStart="@dimen/_2sdp"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintEnd_toEndOf="@+id/delete_patient_account_tv"
                    app:layout_constraintStart_toStartOf="@+id/calendar"
                    app:layout_constraintTop_toBottomOf="@+id/calendar"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginBottom="@dimen/_16ssp">

            </androidx.recyclerview.widget.RecyclerView>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>



</layout>


