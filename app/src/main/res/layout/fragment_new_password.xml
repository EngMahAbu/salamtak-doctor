<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/new_theme_color">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

<!--                <include-->
<!--                    android:id="@+id/toolbar"-->
<!--                    layout="@layout/authentication_toolbar"-->
<!--                    android:visibility="gone" />-->

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_percent="0.04" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline_half"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_percent="1.0" />

                <ImageView
                    android:id="@+id/imageView7"
                    android:layout_width="@dimen/_130sdp"
                    android:layout_height="@dimen/_45sdp"
                    android:layout_marginTop="@dimen/_30sdp"
                    android:visibility="gone"
                    android:src="@drawable/ic_new_logo"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/iv_back_bg" />

                <ImageView
                    android:id="@+id/imageView11"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:paddingHorizontal="@dimen/_12sdp"
                    android:src="@drawable/ic_baseline_arrow_back_24"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_back_bg"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/iv_back_bg"
                    app:tint="@color/black" />

                <TextView
                    android:id="@+id/iv_back_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_24sdp"
                    android:drawablePadding="@dimen/_6sdp"
                    android:fontFamily="@font/avenir_bold"
                    android:text="@string/change_password"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_16ssp"
                    app:layout_constraintStart_toEndOf="@+id/imageView11"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_help"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:background="@drawable/bg_btn_blue"
                    android:backgroundTint="#E8E8FD"
                    android:drawableLeft="@drawable/frame__2_"
                    android:drawablePadding="@dimen/_6sdp"
                    android:elevation="@dimen/_2sdp"
                    android:fontFamily="@font/avenir_regular"
                    android:paddingHorizontal="@dimen/_6sdp"
                    android:paddingVertical="@dimen/_6sdp"
                    android:text="Help"
                    android:visibility="gone"
                    android:textColor="@color/new_themeBlue_color"
                    android:textSize="@dimen/_10ssp"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_back_bg"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/iv_back_bg" />


<!--                <TextView-->
<!--                    android:id="@+id/new_password_txt"-->
<!--                    android:layout_width="match_parent"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:layout_marginHorizontal="@dimen/_25sdp"-->
<!--                    android:layout_marginTop="16dp"-->
<!--                    android:fontFamily="@font/my_font_medium"-->
<!--                    android:gravity="center"-->
<!--                    android:text="@string/please_enter_the_new_password_and_remember"-->
<!--                    android:textColor="@color/head_color"-->
<!--                    android:textSize="16sp"-->
<!--                    android:visibility="visible"-->
<!--                    app:layout_constraintEnd_toEndOf="parent"-->
<!--                    app:layout_constraintStart_toStartOf="parent"-->
<!--                    app:layout_constraintTop_toBottomOf="@+id/iv_back_bg" />-->

                <ImageView
                    android:id="@+id/imageView_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_splash_bg2"
                    android:visibility="visible"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/guideline_half" />


                <!--                <TextView-->
                <!--                    android:id="@+id/password_tv"-->
                <!--                    android:layout_width="wrap_content"-->
                <!--                    android:layout_height="wrap_content"-->
                <!--                    android:layout_marginHorizontal="@dimen/_20sdp"-->
                <!--                    android:layout_marginTop="@dimen/_100sdp"-->
                <!--                    android:fontFamily="@font/my_font_regular"-->
                <!--                    android:text="@string/password"-->
                <!--                    android:textColor="@color/head_color"-->
                <!--                    android:textSize="@dimen/_13ssp"-->
                <!--                    app:layout_constraintStart_toStartOf="parent"-->
                <!--                    app:layout_constraintTop_toBottomOf="@id/old_password_layout" />-->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/old_password_layout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_14sdp"
                    android:background="@color/transparent"
                    android:hint="@string/old_password"
                    android:visibility="visible"
                    app:layout_constraintEnd_toEndOf="@+id/password_layout"
                    app:layout_constraintStart_toStartOf="@+id/password_layout"
                    app:layout_constraintTop_toBottomOf="@+id/imageView7"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="@color/sky_main">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/old_password_et"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:inputType="textPassword"
                        android:paddingEnd="@dimen/_32sdp" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/password_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:hint="@string/new_password"
                    app:boxStrokeColor="@color/sky_main"
                    app:layout_constraintTop_toBottomOf="@+id/error_old_password"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="@color/sky_main">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/password_et"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:inputType="textPassword" />

                </com.google.android.material.textfield.TextInputLayout>


                <!--                <TextView-->
                <!--                    android:id="@+id/confirm_password_tv"-->
                <!--                    android:layout_width="wrap_content"-->
                <!--                    android:layout_height="wrap_content"-->
                <!--                    android:layout_marginHorizontal="@dimen/_20sdp"-->
                <!--                    android:layout_marginTop="@dimen/_10sdp"-->
                <!--                    android:fontFamily="@font/my_font_regular"-->
                <!--                    android:text="@string/confirm_password"-->
                <!--                    android:textColor="@color/head_color"-->
                <!--                    android:textSize="@dimen/_13ssp"-->
                <!--                    app:layout_constraintStart_toStartOf="parent"-->
                <!--                    app:layout_constraintTop_toBottomOf="@id/password_layout" />-->

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/confirm_password_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:hint="@string/confirm_password"
                    app:boxStrokeColor="@color/sky_main"
                    app:layout_constraintTop_toBottomOf="@+id/error_new_password"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="@color/sky_main">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/confirm_password_et"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:inputType="textPassword" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tv_error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_6sdp"
                    android:fontFamily="@font/avenir_regular"
                    android:text="@string/confirm_password_field_required"
                    android:textSize="@dimen/_8ssp"
                    android:visibility="gone"
                    android:textColor="@color/red"
                    app:layout_constraintStart_toStartOf="@id/confirm_password_layout"
                    app:layout_constraintTop_toBottomOf="@+id/confirm_password_layout" />

                <ImageView
                    android:id="@+id/iv_error"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:layout_marginEnd="@dimen/_50sdp"
                    android:src="@drawable/ic_error"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@+id/confirm_password_layout"
                    app:layout_constraintEnd_toEndOf="@+id/confirm_password_layout"
                    app:layout_constraintTop_toTopOf="@+id/confirm_password_layout" />

                <ImageView
                    android:id="@+id/iv_old_pass_error"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:layout_marginEnd="65dp"
                    android:src="@drawable/ic_error"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@+id/old_password_layout"
                    app:layout_constraintEnd_toEndOf="@+id/old_password_layout"
                    app:layout_constraintTop_toTopOf="@+id/old_password_layout" />

                <ImageView
                    android:id="@+id/iv_passerror"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:layout_marginEnd="65dp"
                    android:src="@drawable/ic_error"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@+id/password_layout"
                    app:layout_constraintEnd_toEndOf="@+id/password_layout"
                    app:layout_constraintTop_toTopOf="@+id/password_layout" />

                <TextView
                    android:id="@+id/error_old_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_6sdp"
                    android:text="@string/old_password_field_required"
                    android:textColor="@color/red"
                    android:visibility="gone"
                    android:textSize="@dimen/_8ssp"
                    app:layout_constraintStart_toStartOf="@+id/old_password_layout"
                    app:layout_constraintTop_toBottomOf="@+id/old_password_layout" />

                <TextView
                    android:id="@+id/error_new_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_6sdp"
                    android:text="@string/new_password_field_required"
                    android:textColor="@color/red"
                    android:textSize="@dimen/_8ssp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="@+id/password_layout"
                    app:layout_constraintTop_toBottomOf="@+id/password_layout" />


                <TextView
                    android:id="@+id/submit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="22dp"
                    android:background="@drawable/bg_btn_border_gray_transprent"
                    android:backgroundTint="@color/new_themeBlue_color"
                    android:elevation="@dimen/_10sdp"
                    android:fontFamily="@font/my_font_bold"
                    android:gravity="center"
                    android:padding="14dp"
                    android:text="@string/save"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_error"
                    tools:layout_editor_absoluteX="16dp" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>


    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>