<?xml version="1.0" encoding="utf-8"?>
<!-- Scrolls when the keyboard or a short screen leaves too little room for Save -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_round_bg">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="12dp">

    <!-- Header: title, then edit (pencil / "Update") and delete for an existing branch -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_sheet_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/avenir_bold"
            android:text="@string/hospital_add_branch"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/iv_edit"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/hospital_edit"
            android:padding="8dp"
            android:src="@drawable/ic_edit"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_update"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/avenir_bold"
            android:padding="8dp"
            android:text="@string/update"
            android:textColor="@color/new_themeBlue_color"
            android:textSize="14sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/iv_delete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/hospital_delete_branch_confirm"
            android:padding="8dp"
            android:src="@drawable/svg_trash"
            android:visibility="gone"
            app:tint="@color/red" />
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_branch_name_en"
        style="@style/HospitalFieldLayout"
        android:hint="@string/hospital_name_en">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_branch_name_en"
            style="@style/HospitalFieldEdit" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_branch_name_ar"
        style="@style/HospitalFieldLayout"
        android:hint="@string/hospital_name_ar">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_branch_name_ar"
            style="@style/HospitalFieldEdit" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_branch_phone"
        style="@style/HospitalFieldLayout"
        android:hint="@string/hospital_phone">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_branch_phone"
            style="@style/HospitalFieldEdit"
            android:inputType="phone"
            android:maxLength="11" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tv_branch_city"
        style="@style/HospitalPickerField"
        android:hint="@string/choose_city" />

    <TextView
        android:id="@+id/tv_branch_area"
        style="@style/HospitalPickerField"
        android:hint="@string/choose_area" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_branch_street"
        style="@style/HospitalFieldLayout"
        android:hint="@string/street_and_landmark">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_branch_street"
            style="@style/HospitalFieldEdit" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_save"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/new_themeBlue_color"
        android:enabled="false"
        android:fontFamily="@font/avenir_bold"
        android:text="@string/save"
        android:textAllCaps="false"
        android:textColor="@color/white"
        app:cornerRadius="6dp" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:indeterminateTint="@color/new_themeBlue_color"
        android:visibility="gone" />
</LinearLayout>
</androidx.core.widget.NestedScrollView>
