<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:tools="http://schemas.android.com/tools"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:orientation="vertical">
    <RelativeLayout
            android:id="@+id/clinics_tv"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginHorizontal="@dimen/_12sdp">

        <TextView
                android:id="@+id/new_peroid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:drawablePadding="@dimen/_6sdp"
                android:fontFamily="@font/avenir_bold"
                android:text="@string/add_new_period"
                android:textColor="@color/black"
                android:textSize="@dimen/_16ssp">

        </TextView>
        <ImageView
                android:id="@+id/help2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/help"
                android:padding="@dimen/_2sdp"
                android:visibility="gone"
                android:layout_alignParentBottom="true"/>
        <TextView
                android:id="@+id/tv_Clinicprofile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:drawablePadding="@dimen/_6sdp"
                android:fontFamily="@font/avenir_bold"
                android:text="Clinic profile"
                android:visibility="gone"
                android:textColor="@color/black"
                android:textSize="@dimen/_16ssp">

        </TextView>
        <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/day_switch1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:elevation="@dimen/_3sdp"
                android:visibility="gone"
                android:layout_alignParentEnd="true"
                android:thumb="@drawable/switch_thumb_selector"
                app:track="@drawable/switch_selector" />

    </RelativeLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/_22sdp">

        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_SelectDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/services_select"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
            <TextView
                    android:id="@+id/day_select"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_42sdp"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    android:background="@drawable/otp_border"
                    android:elevation="@dimen/_2sdp"
                    android:fontFamily="@font/my_font_medium"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/_10sdp"
                    android:paddingEnd="@dimen/_50sdp"
                    android:hint="@string/select_day"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_10ssp"
                    android:layout_marginBottom="@dimen/_5sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            <TextView
                    android:id="@+id/date_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:elevation="@dimen/_4sdp"
                    android:fontFamily="@font/my_font_regular"
                    android:textColor="@color/hint_color"
                    android:textSize="@dimen/_11ssp"
                    app:layout_constraintStart_toStartOf="@+id/day_select"
                    app:layout_constraintTop_toTopOf="@+id/day_select"
            app:layout_constraintBottom_toBottomOf="@+id/day_select"
            />

            <ImageView
                    android:id="@+id/iv_day"
                    android:layout_width="@dimen/_22sdp"
                    android:layout_height="@dimen/_22sdp"
                    android:layout_marginEnd="@dimen/_12sdp"
                    android:elevation="@dimen/_10sdp"
                    android:src="@drawable/calendar"
                    app:layout_constraintBottom_toBottomOf="@+id/day_select"
                    app:layout_constraintEnd_toEndOf="@+id/day_select"
                    app:layout_constraintTop_toTopOf="@+id/day_select" />
        </androidx.constraintlayout.widget.ConstraintLayout>



        <TextView
                android:id="@+id/services_select"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_42sdp"
                android:layout_marginHorizontal="@dimen/_12sdp"
                android:background="@drawable/otp_border"
                android:elevation="@dimen/_2sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:fontFamily="@font/my_font_medium"
                android:gravity="center_vertical"
                android:text="@string/type_of_services"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_50sdp"
                android:textColor="@color/black"
                android:textSize="@dimen/_10ssp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_SelectDate" />
        <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_Clinic_services_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="5dp"
                android:layout_marginStart="20dp"
                android:gravity="center"
                android:padding="2dp"
                android:text="gggggggg"
                android:textColor="@color/red"
                android:textSize="12sp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/services_select"
                app:layout_constraintBottom_toTopOf="@+id/sublinear"
        />

        <TextView
                android:id="@+id/services_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:elevation="@dimen/_4sdp"
                android:fontFamily="@font/my_font_regular"
                android:textColor="@color/hint_color"
                android:textSize="@dimen/_11ssp"
                app:layout_constraintStart_toStartOf="@+id/services_select"
                app:layout_constraintTop_toTopOf="@+id/services_select"
            app:layout_constraintBottom_toBottomOf="@+id/services_select"
        />

        <ImageView
                android:id="@+id/iv_spinner"
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:layout_marginEnd="@dimen/_12sdp"
                android:elevation="@dimen/_10sdp"
                android:src="@drawable/arrow___down_3"
                app:layout_constraintBottom_toBottomOf="@+id/services_select"
                app:layout_constraintEnd_toEndOf="@+id/services_select"
                app:layout_constraintTop_toTopOf="@+id/services_select" />

        <com.google.android.material.card.MaterialCardView
                android:id="@+id/mCard_Clinic_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_19sdp"
                app:cardCornerRadius="@dimen/_6sdp"
                app:cardElevation="@dimen/_2sdp"
                app:cardUseCompatPadding="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sublinear"
                app:layout_goneMarginTop="@dimen/_30sdp">

            <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/filledTextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/add_max_number_of_patients_to_be_able_to_book"
                    android:textSize="@dimen/_12ssp"
                    app:boxBackgroundMode="none"
                    android:paddingBottom="3dp"
                   app:boxStrokeColor="@color/colorPrimary"
                    app:hintTextColor="#AEB3BE">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/clinic_name_et"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_40sdp"
                        android:background="@color/white"
                        android:fontFamily="@font/avenir_regular"
                        android:inputType="number"
                        android:singleLine="true"
                        android:text=""
                        android:enabled="false"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_10ssp"/>
            </com.google.android.material.textfield.TextInputLayout>
        </com.google.android.material.card.MaterialCardView>
        <ImageView
            android:id="@+id/iv_durationspinner"
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:layout_marginEnd="@dimen/_12sdp"
            android:elevation="@dimen/_10sdp"
            android:src="@drawable/arrow___down_3"
            app:layout_constraintEnd_toEndOf="@+id/mCard_Clinic_name"
            app:layout_constraintTop_toTopOf="@+id/mCard_Clinic_name"
            app:layout_constraintBottom_toBottomOf="@+id/mCard_Clinic_name"
            />
        <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_Clinic_maxPatient"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="5dp"
                android:layout_marginStart="20dp"
                android:gravity="center"
                android:padding="2dp"
                android:text=""
                android:textColor="@color/red"
                android:textSize="12sp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mCard_Clinic_name"
                app:layout_constraintBottom_toTopOf="@+id/mCardCheckfee"
        />

        <com.google.android.material.card.MaterialCardView
                android:id="@+id/mCardCheckfee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_12sdp"
                app:cardCornerRadius="@dimen/_6sdp"
                app:cardElevation="@dimen/_2sdp"
                app:cardUseCompatPadding="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mCard_Clinic_name"
                app:layout_goneMarginTop="@dimen/_30sdp">

            <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/Checkfee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/clinic_check_up_fee"
                    android:textSize="@dimen/_12ssp"
                    app:boxBackgroundMode="none"
                    android:paddingBottom="2dp"
                    android:paddingTop="2dp"
                    app:boxStrokeColor="@color/colorPrimary"
                    app:hintTextColor="#AEB3BE">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/checkfee_et"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_40sdp"
                        android:background="@color/white"
                        android:fontFamily="@font/avenir_regular"
                        android:inputType="number"
                        android:gravity="start"
                        android:singleLine="true"
                        android:text=""
                        android:textColor="@color/black"
                        android:textSize="@dimen/_10ssp" />

            </com.google.android.material.textfield.TextInputLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_Clinic_Checkfee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="5dp"
                android:layout_marginStart="20dp"
                android:gravity="center"
                android:padding="2dp"
                android:text=""
                android:textColor="@color/red"
                android:textSize="12sp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mCardCheckfee"
                app:layout_constraintBottom_toTopOf="@+id/mCardCheckupfee"
        />
        <TextView
                android:id="@+id/EGPtv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_15sdp"
                android:layout_marginEnd="@dimen/_12sdp"
                android:elevation="@dimen/_4sdp"
                android:fontFamily="@font/my_font_regular"
                android:text= "@string/pound"
                android:textColor="@color/black"
                android:textSize="@dimen/_10ssp"
                app:layout_constraintBottom_toBottomOf="@+id/mCardCheckfee"
                app:layout_constraintEnd_toEndOf="@+id/mCardCheckfee"
        />


        <com.google.android.material.card.MaterialCardView
                android:id="@+id/mCardCheckupfee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_12sdp"
                app:cardCornerRadius="@dimen/_6sdp"
                app:cardElevation="@dimen/_2sdp"
                app:cardUseCompatPadding="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mCardCheckfee"
                app:layout_goneMarginTop="@dimen/_30sdp">

            <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/Checkupfee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/follow_up_fee"
                    android:textSize="@dimen/_12ssp"
                    app:boxStrokeColor="@color/colorPrimary"
                    app:boxBackgroundMode="none"
                    android:paddingTop="3dp"
                    android:paddingBottom="2dp"
                    app:hintTextColor="#AEB3BE">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/checkupfee_et"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_40sdp"
                        android:background="@color/white"
                        android:fontFamily="@font/avenir_regular"
                        android:inputType="number"
                        android:singleLine="true"
                        android:text=""
                        android:textColor="@color/black"
                        android:textSize="@dimen/_10ssp" />
            </com.google.android.material.textfield.TextInputLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
                android:id="@+id/EGPtv2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_15sdp"
                android:layout_marginEnd="@dimen/_12sdp"
                android:elevation="@dimen/_4sdp"
                android:fontFamily="@font/my_font_regular"
                android:text="@string/pound"
                android:textColor="@color/black"
                android:textSize="@dimen/_10ssp"
                app:layout_constraintBottom_toBottomOf="@+id/mCardCheckupfee"
                app:layout_constraintEnd_toEndOf="@+id/mCardCheckupfee"
        />

        <LinearLayout
                android:id="@+id/sublinear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:weightSum="2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/services_select">

            <RelativeLayout
                    android:id="@+id/relative1"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_margin="@dimen/_4sdp"
                    android:elevation="@dimen/_4sdp"
                    android:background="@drawable/otp_border"
                    android:layout_weight="1">
                <TextView
                        android:id="@+id/operation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_4sdp"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:elevation="@dimen/_4sdp"
                        android:fontFamily="@font/my_font_regular"
                        android:text="@string/operating_hours"
                        android:textColor="@color/hint_color"
                        android:textSize="@dimen/_11ssp"
                />
                <TextView
                        android:id="@+id/hoursfrom"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingStart="@dimen/_6sdp"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:layout_below="@id/operation"
                        android:elevation="@dimen/_4sdp"
                        android:paddingEnd="@dimen/_23sdp"
                        android:fontFamily="@font/my_font_regular"
                        android:hint=""
                        android:layout_centerVertical="true"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_10ssp"
                />
                <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/_10sdp"
                        android:src="@drawable/time_circle">

                </ImageView>
            </RelativeLayout>
            <RelativeLayout
                    android:id="@+id/relative2"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_margin="@dimen/_4sdp"
                    android:layout_marginVertical="@dimen/_1sdp"
                    android:elevation="@dimen/_4sdp"
                    android:background="@drawable/otp_border"
                    android:layout_weight="1">
                <TextView
                        android:id="@+id/operation2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_4sdp"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:elevation="@dimen/_4sdp"
                        android:fontFamily="@font/my_font_regular"
                        android:text="@string/timeto"
                        android:textColor="@color/hint_color"
                        android:textSize="@dimen/_11ssp"
                />
                <TextView
                        android:id="@+id/hoursto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingStart="@dimen/_6sdp"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:layout_below="@id/operation2"
                        android:elevation="@dimen/_4sdp"
                        android:paddingEnd="@dimen/_23sdp"
                        android:fontFamily="@font/my_font_regular"
                        android:hint=""
                        android:layout_centerVertical="true"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_10ssp"
                />
                <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/_10sdp"
                        android:src="@drawable/time_circle">

                </ImageView>






            </RelativeLayout>

        </LinearLayout>
        <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_Clinic_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="5dp"
                android:layout_marginStart="20dp"
                android:gravity="center"
                android:padding="2dp"
                android:text="gggggggg"
                android:textColor="@color/red"
                android:textSize="12sp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sublinear"
                app:layout_constraintBottom_toTopOf="@+id/mCard_Clinic_name"
        />

        <com.google.android.material.button.MaterialButton
                android:id="@+id/savePeriod_btn"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_42sdp"
                android:layout_margin="@dimen/_12sdp"
                android:backgroundTint="@color/new_themeBlue_color"
                android:fontFamily="@font/avenir_bold"
                android:gravity="center"
                android:text="@string/save"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:cornerRadius="@dimen/_6sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/mCardCheckupfee" />

        <com.google.android.material.button.MaterialButton
                android:id="@+id/deletePeriod_btn"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_42sdp"
                android:layout_margin="@dimen/_12sdp"
                android:backgroundTint="#FDE3E1"
                android:fontFamily="@font/avenir_bold"
                android:gravity="center"
                android:text="@string/delete"
                android:textColor="@color/red"
                android:textSize="14sp"
                android:visibility="gone"
                android:textAllCaps="false"
                app:cornerRadius="@dimen/_6sdp"
                app:icon="@drawable/delete"
                app:iconTint="#CB544B"
                app:iconGravity="textStart"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/savePeriod_btn" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</LinearLayout>