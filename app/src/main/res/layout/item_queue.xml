<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_queue"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/text_gray4"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_booking"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.54" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_wait"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.77" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_number"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardBackgroundColor="@color/move"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_number"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/avenir_bold"
                android:gravity="center"
                android:textColor="@color/color_primary"
                android:textSize="@dimen/_12ssp"
                tools:text="2" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_patient_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            android:ellipsize="end"
            android:fontFamily="@font/avenir_bold"
            android:maxLines="1"
            android:textColor="@color/new_title_color"
            android:textSize="@dimen/_12ssp"
            app:layout_constraintEnd_toStartOf="@+id/guideline_booking"
            app:layout_constraintStart_toEndOf="@+id/card_number"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Aya ayaaa ayaaa" />

        <TextView
            android:id="@+id/tv_clinic_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/avenir_regular"
            android:maxLines="1"
            android:textColor="@color/color_primary"
            android:textSize="@dimen/_9ssp"
            app:layout_constraintEnd_toEndOf="@+id/tv_patient_name"
            app:layout_constraintStart_toStartOf="@+id/tv_patient_name"
            app:layout_constraintTop_toBottomOf="@+id/tv_patient_name"
            tools:text="aya yasser" />

        <TextView
            android:id="@+id/tv_booking_time_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:fontFamily="@font/avenir_regular"
            android:text="@string/original_booking_time"
            android:textColor="@color/new_text_gray"
            android:textSize="@dimen/_9ssp"
            app:layout_constraintEnd_toStartOf="@+id/guideline_wait"
            app:layout_constraintStart_toStartOf="@+id/guideline_booking"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_wait_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/avenir_regular"
            android:text="@string/estimated_waiting_time"
            android:textColor="@color/new_text_gray"
            android:textSize="@dimen/_9ssp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/guideline_wait"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier_labels"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tv_booking_time_label,tv_wait_label" />

        <TextView
            android:id="@+id/tv_booking_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/sf_pro_display_semibold"
            android:textColor="@color/black"
            android:textSize="@dimen/_11ssp"
            app:layout_constraintEnd_toEndOf="@+id/tv_booking_time_label"
            app:layout_constraintStart_toStartOf="@+id/tv_booking_time_label"
            app:layout_constraintTop_toBottomOf="@+id/barrier_labels"
            tools:text="11:00" />

        <TextView
            android:id="@+id/tv_wait"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/sf_pro_display_semibold"
            android:textColor="@color/black"
            android:textSize="@dimen/_11ssp"
            app:layout_constraintEnd_toEndOf="@+id/tv_wait_label"
            app:layout_constraintStart_toStartOf="@+id/tv_wait_label"
            app:layout_constraintTop_toBottomOf="@+id/barrier_labels"
            tools:text="15 min" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/text_gray4"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_wait">

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/avenir_medium"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textColor="@color/color_primary"
                android:textSize="@dimen/_9ssp"
                tools:text="Waiting" />
        </com.google.android.material.card.MaterialCardView>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_complete"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_btn_blue"
            android:backgroundTint="#4CA530"
            android:fontFamily="@font/avenir_bold"
            android:text="@string/queue_complete"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/_11ssp"
            app:layout_constraintEnd_toStartOf="@+id/btn_cancel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/card_status" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_queue_cancel"
            android:fontFamily="@font/avenir_bold"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textColor="#E5544B"
            android:textSize="@dimen/_11ssp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btn_complete"
            app:layout_constraintTop_toTopOf="@+id/btn_complete" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
