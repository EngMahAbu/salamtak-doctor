<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_color_gray">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"

        >

        <ImageView
            android:id="@+id/imageView5"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scaleType="fitXY"
            android:src="@drawable/iv_doctor_new"
            app:layout_constraintBottom_toTopOf="@+id/welcome_txv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/arrow"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="31dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_arrowleft"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/forget_password_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="24dp"
            android:drawablePadding="6dp"
            android:drawableTint="@color/black"
            android:fontFamily="@font/avenir_bold"
            android:text="@string/check_phone"
            android:textColor="@color/blue"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@+id/arrow"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_help"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/bg_btn_blue"
            android:backgroundTint="#E8E8FD"
            android:drawableLeft="@drawable/frame__2_"
            android:drawablePadding="6dp"
            android:elevation="2dp"
            android:fontFamily="@font/avenir_regular"
            android:paddingHorizontal="6dp"
            android:paddingVertical="6dp"
            android:text="@string/help"
            android:textColor="@color/new_themeBlue_color"
            android:textSize="10sp"
            app:layout_constraintBottom_toBottomOf="@+id/forget_password_tv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/forget_password_tv" />

        <include
            android:id="@+id/toolbar"
            layout="@layout/authentication_toolbar"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imageView6"
            android:layout_width="130dp"
            android:layout_height="45dp"
            android:layout_marginTop="40dp"
            android:src="@drawable/ic_new_logo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/forget_password_tv" />

        <TextView
            android:id="@+id/welcome_txv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/avenir_regular"
            android:gravity="center"
            android:text="@string/please_enter_the_verification_code_we_sent_to_your_mobiles"
            android:textColor="@color/hint_color"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageView6" />

        <com.mukesh.OtpView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:cursorVisible="true"
            android:inputType="number"
            android:itemBackground="@color/text_gray4"
            android:textCursorDrawable="@color/text_gray6"
            android:visibility="gone"
            app:OtpCursorColor="@color/text_gray6"
            app:OtpCursorWidth=".5dp"
            app:OtpHideLineWhenFilled="false"
            app:OtpItemCount="4"
            app:OtpItemHeight="@dimen/_55sdp"
            app:OtpItemRadius="@dimen/_10sdp"
            app:OtpItemSpacing="@dimen/_10sdp"
            app:OtpItemWidth="@dimen/_55sdp"
            app:OtpLineWidth="1dp"
            app:OtpState_filled="true"
            app:OtpViewType="rectangle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/welcome_txv" />

        <in.aabhasjindal.otptextview.OtpTextView
            android:id="@+id/otp_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:elevation="2dp"
            app:bar_enabled="false"
            app:box_margin="@dimen/_8sdp"
            app:height="@dimen/_42sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/welcome_txv"
            app:length="4"
            app:otp_box_background="@drawable/otp_border"
            app:otp_box_background_active="@drawable/otp_border"
            app:otp_box_background_inactive="@drawable/otp_border"
            app:otp_text_size="@dimen/_18ssp"
            app:width="@dimen/_42sdp" />

        <TextView
            android:id="@+id/otp_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/avenir_regular"
            android:text="@string/incorrect_code_please_try_again"
            android:textColor="@color/error_stroke_color"
            android:textSize="12sp"
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/send_btn" />


        <TextView
            android:id="@+id/otp_sent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="70dp"
            android:fontFamily="@font/my_font_regular"
            android:gravity="center"
            android:text="+1 898 860 ***"
            android:textColor="@color/green"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/welcome_txv" />

        <TextView
            android:id="@+id/code_sent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="15dp"
            android:fontFamily="@font/avenir_regular"
            android:gravity="center"
            android:text="@string/activated_code_will_be_sent_within"
            android:textColor="@color/blue"
            android:textSize="10sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/otp_view" />


        <TextView
            android:id="@+id/otp_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/avenir_regular"
            android:text="02:29"
            android:textColor="@color/sky_main"
            android:textSize="11sp"
            android:visibility="visible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/code_sent"

            />

        <View
            android:id="@+id/view_otp"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/sky_main"
            app:layout_constraintBottom_toBottomOf="@+id/otp_timer"
            app:layout_constraintEnd_toEndOf="@+id/otp_timer"
            app:layout_constraintStart_toStartOf="@+id/otp_timer" />

        <TextView
            android:id="@+id/otp_send_again"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:enabled="false"
            android:fontFamily="@font/avenir_regular"
            android:gravity="center"
            android:text="@string/send_again"
            android:textColor="@color/gray"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/otp_error" />

        <!--        <ImageView-->
        <!--            android:id="@+id/footer_bg"-->
        <!--            android:layout_width="match_parent"-->
        <!--            android:layout_height="100dp"-->
        <!--            android:layout_marginBottom="-40dp"-->
        <!--            android:src="@drawable/bg_solid_sky"-->
        <!--            app:layout_constraintBottom_toBottomOf="parent"-->
        <!--            app:layout_constraintEnd_toEndOf="parent"-->
        <!--            app:layout_constraintStart_toStartOf="parent" />-->

        <!--        <TextView-->
        <!--            android:id="@+id/for_support_tv"-->
        <!--            android:layout_width="wrap_content"-->
        <!--            android:layout_height="wrap_content"-->
        <!--            android:layout_marginStart="@dimen/_20sdp"-->
        <!--            android:layout_marginTop="13dp"-->
        <!--            android:fontFamily="@font/my_font_bold"-->
        <!--            android:text="@string/for_support_call"-->
        <!--            android:textColor="@color/head_color"-->
        <!--            android:textSize="@dimen/_16ssp"-->
        <!--            app:layout_constraintStart_toStartOf="parent"-->
        <!--            app:layout_constraintTop_toTopOf="@id/footer_bg" />-->


        <!--        <TextView-->
        <!--            android:id="@+id/num_tv"-->
        <!--            android:layout_width="wrap_content"-->
        <!--            android:layout_height="wrap_content"-->
        <!--            android:layout_marginTop="13dp"-->
        <!--            android:layout_marginEnd="@dimen/_20sdp"-->
        <!--            android:fontFamily="@font/my_font_bold"-->
        <!--            android:text="@string/_17143"-->
        <!--            android:textColor="@color/white"-->
