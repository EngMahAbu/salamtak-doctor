<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_v"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent=".5" />

        <include
            android:id="@+id/toolbar"
            android:visibility="gone"
            layout="@layout/authentication_toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_70sdp"
            android:elevation="@dimen/_5sdp" />

        <TextView
            android:id="@+id/tv_logout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_5sdp"
            android:layout_marginTop="@dimen/_4sdp"
            android:elevation="@dimen/_2sdp"
            android:fontFamily="@font/my_font_semibold"
            android:letterSpacing=".02"
            android:lineSpacingExtra="1dp"
            android:paddingHorizontal="@dimen/_15sdp"
            android:visibility="gone"
            android:paddingVertical="@dimen/_10sdp"
            android:text="@string/logout"
            android:textColor="@color/white"
            android:textSize="@dimen/_11ssp"
            app:layout_constraintBottom_toBottomOf="@id/toolbar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/toolbar" />

        <include
            android:id="@+id/edit_clinic_toolbar"
            layout="@layout/appointment_toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_130sdp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/first_guideline_horizontal" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/first_guideline_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent=".06" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/sec_guideline_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent=".20" />

        <RadioGroup
            android:id="@+id/steps_radio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:orientation="horizontal"
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/clinic_toolbar">

            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/info_rb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/choose_selector_language"
                android:button="@null"
                android:gravity="center"
                android:padding="8dp"
                android:text="@string/info_clinic"
                android:textColor="@color/choose_selector"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/schedule_rb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/choose_selector_language"
                android:button="@null"
                android:checked="true"
                android:gravity="center"
                android:padding="8dp"
                android:text="@string/schedule"
                android:textColor="@color/choose_selector"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/vaction_rb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/choose_selector_language"
                android:button="@null"
                android:gravity="center"
                android:padding="4dp"
                android:text="@string/not_available"
                android:textColor="@color/choose_selector"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatRadioButton
                android:id="@+id/gallery_rb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/choose_selector_language"
                android:button="@null"
                android:gravity="center"
                android:padding="8dp"
                android:text="@string/gallery"
                android:textColor="@color/choose_selector"
                android:textSize="16sp"
                android:textStyle="bold" />

        </RadioGroup>

        <include
            android:id="@+id/clinic_toolbar"
            layout="@layout/clinic_toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_80sdp"
            android:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/toolbar" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/services_rv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_4sdp"
            android:layout_marginTop="52dp"
            app:layout_constraintTop_toBottomOf="@id/steps_radio"
            tools:itemCount="1"
            tools:layout_editor_absoluteX="-2dp"
            tools:listitem="@layout/item_new_services" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/schedule_rv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="@dimen/_4sdp"
            app:layout_constraintBottom_toTopOf="@id/profile_bottom_toolbar"
            app:layout_constraintTop_toBottomOf="@id/services_rv"
            app:layout_constraintVertical_bias="1.0"
            tools:itemCount="3"
            tools:layout_editor_absoluteX="30dp"
            tools:listitem="@layout/clinic_schedule_layout" />

        <include
            android:id="@+id/schedule_layout"
            layout="@layout/clinic_schedule_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/clinic_toolbar" />

        <include
            android:id="@+id/profile_bottom_toolbar"
            layout="@layout/bottom_tb_layout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_70sdp"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>