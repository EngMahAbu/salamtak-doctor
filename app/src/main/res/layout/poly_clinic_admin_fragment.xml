<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_color_gray">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_stepper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent=".8">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_step1"
            android:layout_width="43dp"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/imageViewstep1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_steps"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="1dp"
                android:background="@drawable/ic_circlegreen"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_plus"
                    android:layout_width="11dp"
                    android:layout_height="10dp"
                    android:src="@drawable/iv_plus"
                    android:visibility="visible"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_shape1"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_marginStart="7dp"
                android:src="@drawable/ic_shape1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_shape2"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_marginTop="12dp"
                android:src="@drawable/ic_shape2"
                app:layout_constraintBottom_toBottomOf="@+id/layout_steps"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/layout_steps" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_PersonalInfo."
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginTop="5dp"
            android:text="@string/admin"
            android:textColor="@color/blue"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout_step1" />


        <ImageView
            android:id="@+id/imageViewstep1"
            android:layout_width="180dp"
            android:layout_height="3dp"
            android:layout_marginStart="41dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="15dp"
            android:background="@color/gray"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/layout_step1"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/blueimageViewstep1"
            android:layout_width="180dp"
            android:layout_height="3dp"
            android:layout_marginStart="40dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="15dp"
            android:background="@color/blue"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/layout_step1"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_graystep2"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginTop="5dp"
            android:src="@drawable/bg_circlegray"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/imageViewstep1"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_step2"
            android:layout_width="43dp"
            android:layout_height="match_parent"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/imageViewstep1"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_steps2"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="18dp"
                android:layout_marginTop="1dp"
                android:background="@drawable/ic_circlegreen"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/iv_step2shape2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_plusstep2"
                    android:layout_width="11dp"
                    android:layout_height="10dp"
                    android:src="@drawable/iv_plus"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>


            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_step2shape1"
                android:layout_width="17dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_shape1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_step2shape2"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_marginStart="4dp"
                android:layout_marginTop="12dp"
                android:src="@drawable/ic_shape2"
                app:layout_constraintBottom_toBottomOf="@+id/layout_steps2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/layout_steps2"
                app:layout_constraintTop_toTopOf="@+id/layout_steps2" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_Location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/polyclnicinfo"
            android:textColor="@color/blue"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="@+id/layout_step2"
            app:layout_constraintTop_toTopOf="@id/tv_PersonalInfo." />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/layout_all"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/layout_btn"
        app:layout_constraintTop_toBottomOf="@+id/layout_stepper">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_admin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/layout_stepper">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="@dimen/_4sdp">

                    <EditText
                        android:id="@+id/nameEn_et"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_45sdp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginTop="40dp"
                        android:background="@drawable/bg_btn_border_gray_transprent"
                        android:digits="abcdefghijklmnopqrstuvwxyz ABCDEFGHIJKLMNOPQRSTUVWXYZ "
                        android:elevation="1dp"
                        android:fontFamily="@font/avenir_regular"
                        android:gravity="center_vertical"
                        android:hint="@string/polyclinicname"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingStart="10dp"
                        android:paddingTop="15dp"
                        android:singleLine="true"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_13ssp"
                        app:layout_constraintEnd_toEndOf="@id/end_guid_line"
                        app:layout_constraintStart_toStartOf="@id/start_guid_line"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_fullNameError"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="10dp"
                        android:gravity="center"
                        android:padding="1dp"
                        android:text="@string/polyclinicnamerequired"
                        android:textColor="@color/red"
                        android:textSize="12sp"
                        android:visibility="gone"
                        app:layout_constraintBottom_toTopOf="@+id/nameAR_et"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/nameEn_et" />

                    <TextView
                        android:id="@+id/nameEn_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_8ssp"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:elevation="2dp"
                        android:fontFamily="@font/my_font_regular"
                        android:hint="@string/polyclinicname"
                        android:textColorHint="@color/black"
                        android:textSize="@dimen/_10ssp"
                        app:layout_constraintStart_toStartOf="@id/start_guid_line"
                        app:layout_constraintTop_toTopOf="@+id/nameEn_et" />

                    <EditText
                        android:id="@+id/nameAR_et"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_45sdp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_btn_border_gray_transprent"
                        android:digits="أغظضذخثتشرقصفعسنملكيطحزوهدباءجةىؤئا "
                        android:elevation="2dp"
                        android:fontFamily="@font/avenir_regular"
                        android:hint="@string/polyclinicnamear"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingStart="10dp"
                        android:paddingTop="15dp"
                        android:singleLine="true"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_13ssp"
                        app:layout_constraintEnd_toEndOf="@id/end_guid_line"
                        app:layout_constraintStart_toStartOf="@id/start_guid_line"
                        app:layout_constraintTop_toBottomOf="@+id/nameEn_et" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_fullNameARError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="5dp"
                        android:gravity="center"
                        android:padding="2dp"
                        android:text="@string/polyclinicnamearrequired"
                        android:textColor="@color/red"
                        android:textSize="12sp"
                        android:visibility="gone"
                        app:layout_constraintBottom_toTopOf="@+id/CommercialRecNo"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/nameAR_et" />

                    <TextView
                        android:id="@+id/nameAr_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_8ssp"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:elevation="2dp"
                        android:fontFamily="@font/my_font_regular"
                        android:hint="@string/polyclinicnamear"
                        android:textColorHint="@color/black"
                        android:textSize="@dimen/_10ssp"
                        app:layout_constraintStart_toStartOf="@id/start_guid_line"
                        app:layout_constraintTop_toTopOf="@+id/nameAR_et" />


                    <EditText
                        android:id="@+id/CommercialRecNo"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_45sdp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:background="@drawable/bg_btn_border_gray_transprent"
                        android:elevation="2dp"
                        android:fontFamily="@font/avenir_regular"
                        android:hint="@string/polycomericial"
                        android:inputType="number"
                        android:maxLines="1"
                        android:paddingStart="10dp"
                        android:paddingTop="15dp"
                        android:singleLine="true"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_13ssp"
                        app:layout_constraintEnd_toEndOf="@id/end_guid_line"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toStartOf="@id/start_guid_line"
                        app:layout_constraintTop_toBottomOf="@+id/nameAR_et" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_CommercialRecNoError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="5dp"
                        android:gravity="center"
                        android:padding="2dp"
                        android:text="@string/comericalnumberrequired"
                        android:textColor="@color/red"
                        android:textSize="12sp"
                        android:visibility="gone"
                        app:layout_constraintBottom_toTopOf="@+id/TaxCertificateNo"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/CommercialRecNo" />

                    <TextView
                        android:id="@+id/patient_age_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_8ssp"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:elevation="2dp"
                        android:fontFamily="@font/my_font_regular"
                        android:text="@string/polycomericial"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_10ssp"
                        app:layout_constraintStart_toStartOf="@+id/CommercialRecNo"
                        app:layout_constraintTop_toTopOf="@+id/CommercialRecNo" />

                    <EditText
                        android:id="@+id/TaxCertificateNo"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_45sdp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_btn_border_gray_transprent"
                        android:elevation="2dp"
                        android:fontFamily="@font/avenir_regular"
                        android:hint="@string/taxcardnumber"
                        android:inputType="number"
                        android:maxLines="1"
                        android:paddingStart="10dp"
                        android:paddingTop="15dp"
                        android:singleLine="true"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_13ssp"
                        app:layout_constraintEnd_toEndOf="@id/end_guid_line"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toStartOf="@id/start_guid_line"
                        app:layout_constraintTop_toBottomOf="@+id/CommercialRecNo" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_TaxCertificateNoError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="5dp"
                        android:gravity="center"
                        android:padding="2dp"
                        android:text="@string/taxnumberrequired"
                        android:textColor="@color/red"
                        android:textSize="12sp"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/TaxCertificateNo" />

                    <TextView
                        android:id="@+id/patient_phone_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_8ssp"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:elevation="2dp"
                        android:fontFamily="@font/my_font_regular"
                        android:text="@string/taxcardnumber"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_10ssp"
                        app:layout_constraintStart_toStartOf="@+id/TaxCertificateNo"
                        app:layout_constraintTop_toTopOf="@+id/TaxCertificateNo" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/layout_bio_en"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_7sdp"
                        android:layout_marginTop="@dimen/_12sdp"
                        app:cardCornerRadius="@dimen/_6sdp"
                        app:cardElevation="@dimen/_2sdp"
                        app:layout_constraintTop_toBottomOf="@+id/TaxCertificateNo"
                        app:layout_goneMarginTop="@dimen/_30sdp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:hint="@string/polyclinicinfo"
                            android:textColorHint="@color/gray"
                            android:textSize="@dimen/_10ssp"
                            app:boxBackgroundMode="none"
                            app:boxStrokeColor="@color/colorPrimary"
                            app:counterEnabled="true"
                            app:counterMaxLength="500"
                            app:errorEnabled="true"
                            app:helperTextEnabled="true"
                            >

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/bioggraphy"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_80sdp"
                                android:background="@color/white"
                                android:digits="abcdefghijklmnopqrstuvwxyz ABCDEFGHIJKLMNOPQRSTUVWXYZ"
                                android:fontFamily="@font/avenir_regular"
                                android:inputType="text"
                                android:maxLength="500"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_10ssp" />
                        </com.google.android.material.textfield.TextInputLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/layout_bio_ar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_2sdp"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:layout_marginBottom="5dp"
                        app:cardCornerRadius="@dimen/_6sdp"
                        app:layout_constraintTop_toBottomOf="@+id/layout_bio_en"
                        app:cardElevation="@dimen/_2sdp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="start"
                            android:hint="@string/polyclinicinfoar"
                            android:textColorHint="@color/gray"
                            android:textSize="@dimen/_10ssp"
                            app:boxBackgroundMode="none"
                            app:boxStrokeColor="@color/colorPrimary"
                            app:counterEnabled="true"
                            app:counterMaxLength="500"
                            app:errorEnabled="true"
                            app:helperTextEnabled="true"
                            >

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/bioggraphyAr"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_80sdp"
                                android:background="@color/white"
                                android:digits="غظضذخثتشرقصفعسنملكيطحزوهدباءجةىؤئ "                            android:fontFamily="@font/avenir_regular"
                                android:inputType="text"
                                android:maxLength="500"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_10ssp" />
                        </com.google.android.material.textfield.TextInputLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <LinearLayout
                        android:id="@+id/linear"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical"
                        android:visibility="visible"
                        app:layout_constraintEnd_toEndOf="@id/end_guid_line"
                        app:layout_constraintStart_toStartOf="@+id/start_guid_line"
                        app:layout_constraintTop_toBottomOf="@+id/layout_bio_ar">

                        <TextView
                            android:id="@+id/pressure_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/my_font_medium"
                            android:text="@string/taxnumberimage"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            app:layout_constraintStart_toStartOf="@id/start_guid_line"
                            app:layout_constraintTop_toBottomOf="@id/blood_group_select" />

                        <include
                            android:id="@+id/front_view"
                            layout="@layout/doc_uploading_image_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp" />

                        <include
                            android:id="@+id/back_view"
                            layout="@layout/doc_uploading_image_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="15dp"
                            android:layout_marginBottom="10dp" />
                    </LinearLayout>

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/start_guid_line"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.03" />

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/end_guid_line"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.97" />


                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.core.widget.NestedScrollView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_all">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_next"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_chooselang_button"
            android:padding="5dp"
            android:text="@string/next"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent=".9" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:indeterminateTint="@color/white"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/layout_btn"
        app:layout_constraintEnd_toEndOf="@+id/layout_btn"
        app:layout_constraintStart_toStartOf="@+id/layout_btn"
        app:layout_constraintTop_toTopOf="@+id/layout_btn" />

</androidx.constraintlayout.widget.ConstraintLayout>