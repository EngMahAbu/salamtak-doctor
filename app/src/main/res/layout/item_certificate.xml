                android:layout_marginTop="6dp"
                android:background="@drawable/bg_btn_border_gray_transprent"
                app:layout_constraintEnd_toEndOf="@id/end_guid_line"
                app:layout_constraintStart_toStartOf="@id/start_guid_line"
                app:layout_constraintTop_toBottomOf="@+id/date_label">

                <!-- Inside text input layout add
                      an auto complete text view
                        and make its input type to none-->
                <AutoCompleteTextView
                    android:id="@+id/birth_et"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/transparent"
                    android:drawableStart="@drawable/ic_new_calender"
                    android:inputType="number"
                    android:maxLength="4"
                    android:text=""
                    tools:ignore="SpeakableTextPresentCheck" />

            </com.google.android.material.textfield.TextInputLayout>

            <!--                        </com.google.android.material.textfield.TextInputLayout>-->

