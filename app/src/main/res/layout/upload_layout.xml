<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/upload_photo_con"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_70sdp"
        android:layout_marginTop="@dimen/_10sdp">

        <ImageView
            android:id="@+id/upload_photo_iv"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="@dimen/_60sdp"
            android:layout_marginStart="@dimen/_15sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:scaleType="fitXY"
            android:src="@drawable/photo_bg_squared"
            app:layout_constraintStart_toEndOf="@id/upload_photo_txt"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/camera_iv"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:src="@drawable/ic_add_photo_blue"
            app:layout_constraintBottom_toBottomOf="@id/upload_photo_iv"
            app:layout_constraintEnd_toEndOf="@+id/upload_photo_iv"
            app:layout_constraintStart_toStartOf="@+id/upload_photo_iv"
            app:layout_constraintTop_toTopOf="@id/upload_photo_iv" />


        <TextView
            android:id="@+id/upload_photo_txt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:fontFamily="@font/my_font_regular"
            android:text="@string/click_here_to_upload"
            android:textColor="@color/head_color"
            android:textSize="@dimen/_13ssp"
            app:layout_constraintBottom_toBottomOf="@id/upload_photo_iv"
            app:layout_constraintStart_toEndOf="@id/upload_photo_iv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/upload_photo_iv" />

        <ImageView
            android:id="@+id/iv_view"
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:src="@drawable/ic_view"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</layout>