<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_round_bg">


    <TextView
        android:id="@+id/header_title_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_19sdp"
        android:textSize="@dimen/_12ssp"
        android:layout_gravity="center_horizontal"
        android:fontFamily="@font/avenir_bold"
        android:textColor="@color/title_color_black"
        android:text="@string/operation_hours_to"
        />

    <TimePicker
        android:id="@+id/time_picker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:timePickerMode="spinner"
        android:padding="@dimen/_16sdp">

    </TimePicker>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/time_done"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_46sdp"
        android:backgroundTint="@color/new_themeBlue_color"
        android:text="@string/dones"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:textSize="@dimen/_10sdp"
        app:cornerRadius="@dimen/_6sdp">

    </com.google.android.material.button.MaterialButton>

</LinearLayout>