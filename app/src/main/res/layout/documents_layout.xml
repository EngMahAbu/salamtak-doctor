<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
 >

    <data>

        <variable
            name="showDocument"
            type="com.salamtak.domain.entities.response.LegalDocumentsData" />

        <variable
            name="position"
            type="java.lang.Integer" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/item_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nationid"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/avenir_bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/desc_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="8sp"
            android:textColor="#B7B7B7"
            android:layout_marginTop="3dp"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/avenir_regular"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/item_label" />

        <LinearLayout
            android:id="@+id/linearLayout4"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/desc_label">

            <include
                android:id="@+id/front_view"
                layout="@layout/doc_uploading_image_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/back_view"
                layout="@layout/doc_uploading_image_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>





    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>