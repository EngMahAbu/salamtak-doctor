<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/imageView5"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scaleType="fitXY"
            android:src="@drawable/iv_doctor_new"
            app:layout_constraintBottom_toBottomOf="@+id/imageView6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/arrow"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginTop="31dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_arrowleft"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/forget_password_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_24sdp"
            android:layout_marginStart="10dp"
            android:drawablePadding="@dimen/_6sdp"
            android:drawableTint="@color/black"
            android:fontFamily="@font/avenir_bold"
            android:text="@string/check_phone"
            android:textColor="@color/black"
            android:textSize="@dimen/_16ssp"
            app:layout_constraintStart_toEndOf="@+id/arrow"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_help"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_20sdp"
            android:background="@drawable/bg_btn_blue"
            android:backgroundTint="#E8E8FD"
            android:drawableLeft="@drawable/frame__2_"
            android:drawablePadding="@dimen/_6sdp"
            android:elevation="@dimen/_2sdp"
            android:fontFamily="@font/avenir_regular"
            android:paddingHorizontal="@dimen/_6sdp"
            android:paddingVertical="@dimen/_6sdp"
            android:text="@string/help"
            android:textColor="@color/new_themeBlue_color"
            android:textSize="@dimen/_10ssp"
            app:layout_constraintBottom_toBottomOf="@+id/forget_password_tv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/forget_password_tv" />

        <include
            android:id="@+id/toolbar"
            layout="@layout/authentication_toolbar"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/imageView6"
            android:layout_width="@dimen/_130sdp"
            android:layout_height="@dimen/_45sdp"
            android:layout_marginTop="@dimen/_40sdp"
            android:src="@drawable/ic_new_logo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/forget_password_tv" />

        <TextView
            android:id="@+id/verify_phone_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_20sdp"
            android:fontFamily="@font/my_font_regular"
            android:text="@string/verify_mobile_number"
            android:textColor="@color/head_color"
            android:textSize="@dimen/_20ssp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/tb_photo_bg"
            android:layout_width="@dimen/_70sdp"
            android:layout_height="@dimen/_70sdp"
            android:layout_marginTop="@dimen/_25sdp"
            android:background="@drawable/photo_bg"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar" />

        <ImageView
            android:id="@+id/tb_photo_iv"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:src="@drawable/ic_textsms"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/tb_photo_bg"
            app:layout_constraintEnd_toEndOf="@id/tb_photo_bg"
            app:layout_constraintStart_toStartOf="@id/tb_photo_bg"
            app:layout_constraintTop_toTopOf="@id/tb_photo_bg" />

        <!--        Please enter the verification code you received from 01007749950-->
        <TextView
            android:id="@+id/welcome_txv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_20sdp"
            android:layout_marginTop="@dimen/_30sdp"
            android:fontFamily="@font/avenir_regular"
            android:gravity="center"
            android:text="@string/please_enter_the_verification_code_we_sent_to_your_mobile"
            android:textColor="@color/hint_color"
            android:textSize="@dimen/_14ssp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageView6" />
        <TextView
            android:id="@+id/phone_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_70sdp"
            android:fontFamily="@font/my_font_regular"
            android:gravity="center"
            android:textColor="@color/head_color"
            android:textSize="@dimen/_12ssp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/welcome_txv" />

        <com.mukesh.OtpView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_30sdp"
            android:cursorVisible="true"
            android:inputType="number"
            android:itemBackground="@color/text_gray4"
            android:textCursorDrawable="@color/text_gray6"
            android:visibility="gone"
            app:OtpCursorColor="@color/text_gray6"
            app:OtpCursorWidth=".5dp"
            app:OtpHideLineWhenFilled="false"
            app:OtpItemCount="4"
            app:OtpItemHeight="@dimen/_55sdp"
            app:OtpItemRadius="@dimen/_10sdp"
            app:OtpItemSpacing="@dimen/_10sdp"
            app:OtpItemWidth="@dimen/_55sdp"
            app:OtpLineWidth="1dp"
            app:OtpState_filled="true"
            app:OtpViewType="rectangle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/welcome_txv" />

        <in.aabhasjindal.otptextview.OtpTextView
            android:id="@+id/otp_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_26sdp"
            android:elevation="@dimen/_2sdp"
            app:bar_enabled="false"
            app:box_margin="@dimen/_8sdp"
            app:height="@dimen/_42sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/welcome_txv"
            app:length="4"
            app:otp_box_background="@drawable/otp_border"
            app:otp_box_background_active="@drawable/otp_border"
            app:otp_box_background_inactive="@drawable/otp_border"
            app:otp_text_size="@dimen/_18ssp"
            app:width="@dimen/_42sdp" />

        <TextView
            android:id="@+id/otp_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/avenir_regular"
            android:text="@string/incorrect_code_please_try_again"
            android:textColor="@color/error_stroke_color"
            android:layout_marginTop="@dimen/_6sdp"
            android:textSize="@dimen/_12ssp"
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/send_btn" />

        <TextView
            android:id="@+id/otp_sent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:fontFamily="@font/avenir_regular"
            android:gravity="center"
            android:text="@string/verification_code_will_be_sent_within"
            android:textColor="@color/black"
            android:textSize="@dimen/_12ssp"
app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/otp_error" />

        <TextView
            android:id="@+id/otp_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/avenir_regular"
            android:text=""
            android:layout_marginTop="5dp"
            android:textColor="@color/sky_main"
            android:textSize="@dimen/_12ssp"
            android:visibility="visible"
            app:layout_constraintTop_toBottomOf="@+id/otp_sent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            />

        <TextView
            android:id="@+id/otp_send_again"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:enabled="false"
            android:fontFamily="@font/avenir_regular"
            android:gravity="center"
            android:visibility="gone"
            android:text="@string/send_again"
            android:textColor="@color/gray"
            android:textSize="@dimen/_14ssp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/otp_sent" />


        <TextView
            android:id="@+id/send_btn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_45sdp"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_16sdp"
            android:background="@drawable/bg_btn_border_gray_transprent"
            android:backgroundTint="@color/new_themeBlue_color"
            android:elevation="@dimen/_10sdp"
            android:fontFamily="@font/avenir_bold"
            android:gravity="center"
            android:text="@string/confirm"
            android:textColor="@color/white"
            android:textSize="@dimen/_14ssp"
            app:layout_constraintTop_toBottomOf="@+id/otp_view"
            tools:layout_editor_absoluteX="65dp" />

        <View
            android:id="@+id/view_send"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/sky_main"
            app:layout_constraintBottom_toBottomOf="@+id/otp_send_again"
            app:layout_constraintEnd_toEndOf="@+id/otp_send_again"
            app:layout_constraintStart_toStartOf="@+id/otp_send_again" />

        <View
            android:id="@+id/view_otp"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/sky_main"
            app:layout_constraintBottom_toBottomOf="@+id/otp_timer"
            app:layout_constraintEnd_toEndOf="@+id/otp_timer"
            app:layout_constraintStart_toStartOf="@+id/otp_timer" />
        <androidx.cardview.widget.CardView
            android:id="@+id/card_resendCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp"
            app:layout_constraintTop_toBottomOf="@+id/view_otp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="45dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="10dp"
            android:visibility="visible"
            >
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/whatsapp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="@string/if_you_donot_have_whats_app"
                    android:textColor="@color/blue"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:textSize="14sp"
                    />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_resendCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:fontFamily="@font/avenir_regular"
                    android:gravity="center"
                    android:padding="2dp"
                    android:layout_marginStart="20dp"
                    android:text="@string/resend_verification_code"
                    android:textColor="@color/green"
                    android:textSize="16sp"
                    android:visibility="visible"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintHorizontal_chainStyle="packed" />

                <ImageView
                    android:id="@+id/send_Smms"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/telephone"
                    android:layout_marginEnd="20dp"
                    android:visibility="visible"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/whatsapp"
                    app:layout_constraintBottom_toBottomOf="@+id/whatsapp" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_half"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent=".5" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>