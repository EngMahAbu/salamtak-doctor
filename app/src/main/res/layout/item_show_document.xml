<?xml version="1.0" encoding="utf-8"?>
<layout>

    <data>
        <variable
            name="showDocument"
            type="com.salamtak.domain.entities.response.EditDocumentData" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_10sdp">

        <ImageView
            android:id="@+id/iv_add_doc"
            imageUrl="@{showDocument.documentUrl}"
            android:layout_width="@dimen/_90sdp"
            android:layout_height="@dimen/_90sdp"
            android:background="@drawable/bg_btn_border_gray_transparent_selected"
            android:padding="@dimen/_25sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/iv_view"
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:src="@drawable/ic_view"
            app:layout_constraintBottom_toBottomOf="@id/iv_add_doc"
            app:layout_constraintEnd_toEndOf="@id/iv_add_doc"
            app:layout_constraintStart_toStartOf="@id/iv_add_doc"
            app:layout_constraintTop_toTopOf="@id/iv_add_doc" />

        <ImageView
            android:id="@+id/iv_delet"
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:layout_margin="@dimen/_5sdp"
            android:src="@drawable/ic_delete"
            app:layout_constraintEnd_toEndOf="@id/iv_add_doc"
            app:layout_constraintTop_toTopOf="@id/iv_add_doc" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>