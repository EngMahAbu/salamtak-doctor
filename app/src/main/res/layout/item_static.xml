<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <variable
            name="statics"
            type="com.salamtak.domain.entities.response.GetMedicalEximationDtos" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/static_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:layout_marginStart="15dp"
        app:cardElevation="1dp"
        android:layout_marginEnd="15dp"
        app:cardCornerRadius="@dimen/_6sdp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingVertical="@dimen/_16sdp"
            android:paddingHorizontal="@dimen/_16ssp">

            <LinearLayout
                android:id="@+id/ll_clinic"
                android:layout_width="@dimen/_60sdp"
                android:layout_height="@dimen/_60sdp"
                android:background="@drawable/progress_bg_filled"
                android:backgroundTint="#E8E8FD"
                android:gravity="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/clinic_photo"
                    imageUrl="@{statics.image}"
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_gravity="center"
                    app:strokeColor="#E8E8FD"
                    app:strokeWidth="1dp"
                    android:src="@drawable/ic_dialog_confirmed" />
            </LinearLayout>

            <TextView
                android:id="@+id/medical_count_tv"
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_18sdp"
                android:layout_gravity="bottom"
                android:background="@drawable/progress_bg_filled"
                android:fontFamily="@font/avenirs_semibold"
                android:gravity="center"
                android:text="@{String.valueOf(statics.medicalTypeCount)}"
                android:textColor="@color/white"
                android:textSize="@dimen/_12ssp"
                app:layout_constraintTop_toTopOf="@+id/ll_clinic"
                app:layout_constraintEnd_toEndOf="@+id/ll_clinic"
                tools:text="45" />

            <TextView
                android:id="@+id/medical_name_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/avenir_bold"
                android:gravity="center"
                android:layout_marginTop="@dimen/_6sdp"
                android:text="@{statics.medicalTypeName}"
                android:textColor="@color/black"
                android:textSize="@dimen/_10ssp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ll_clinic"
                tools:text="Treated Case" />


        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>


</layout>