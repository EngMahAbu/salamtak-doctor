        <!--            app:hintTextColor="@color/black"-->
        <!--            app:layout_constraintEnd_toEndOf="parent"-->
        <!--            app:layout_constraintStart_toStartOf="parent"-->
        <!--            app:layout_constraintTop_toBottomOf="@id/rx_title_name_txt">-->

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/rx_description_et"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_margin="16dp"
            android:background="@drawable/otp_border"
            android:elevation="1dp"
            android:fontFamily="@font/avenir_regular"
            android:gravity="start"
            android:hint="Medication Instrucations (120 charactres left)"
            android:inputType="text"
            android:maxLines="3"
            android:padding="12dp"
            android:singleLine="true"
            android:text="@{emrDetails.description}"
            android:textSize="14sp"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rx_title_et" />



        <!--        </com.google.android.material.textfield.TextInputLayout>-->

        <LinearLayout
            android:id="@+id/linearAddBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:orientation="horizontal"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="@+id/rx_title_et"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/rx_title_et">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/add_new_btn"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:layout_margin="2dp"
                android:layout_weight="2"
                android:background="@drawable/bg_btn_blue"
                android:padding="2dp"
                android:src="@drawable/ic_add_white"
                android:textColor="@color/white"
                app:tint="@color/white" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/post_report_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_light_gray_solid"
                android:text="@string/reset"
                android:textAllCaps="false"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>