<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_round_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="@font/avenir_bold"
            android:text="@string/hospital_add_slot"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_day"
            style="@style/HospitalPickerField"
            android:hint="@string/hospital_choose_day" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/HospitalSectionTitle"
                    android:layout_marginTop="12dp"
                    android:text="@string/hospital_period_from"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_time_from"
                    style="@style/HospitalPickerField"
                    android:layout_marginTop="4dp"
                    app:drawableEndCompat="@drawable/ic_clock" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/HospitalSectionTitle"
                    android:layout_marginTop="12dp"
                    android:text="@string/hospital_period_to"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_time_to"
                    style="@style/HospitalPickerField"
                    android:layout_marginTop="4dp"
                    app:drawableEndCompat="@drawable/ic_clock" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_duration"
            style="@style/HospitalPickerField"
            android:hint="@string/hospital_detection_duration" />

        <TextView
            android:id="@+id/tv_booking_type"
            style="@style/HospitalPickerField"
            android:hint="@string/hospital_choose_booking_type" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/HospitalFieldLayout"
            android:hint="@string/hospital_checkup_fees">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_fees"
                style="@style/HospitalFieldEdit"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/HospitalFieldLayout"
            android:hint="@string/hospital_follow_up_fees">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_follow_up_fees"
                style="@style/HospitalFieldEdit"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/hint_color"
            android:enabled="false"
            android:fontFamily="@font/avenir_bold"
            android:text="@string/save"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:cornerRadius="6dp" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:indeterminateTint="@color/new_themeBlue_color"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
