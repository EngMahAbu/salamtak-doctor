<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:background="@color/white"
        android:layout_marginBottom="@dimen/_8sdp"
        >

        <LinearLayout
            android:id="@+id/linear"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            app:layout_constraintBottom_toBottomOf="@id/day_switch"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/day_switch"
            android:layout_marginStart="@dimen/_12sdp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/calendar">

            </ImageView>
            <TextView
                android:id="@+id/day_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:fontFamily="@font/avenir_regular"
                android:text="Sunday"
                android:textColor="@color/new_themeBlue_color"
                android:textSize="@dimen/_12ssp"
                />

        </LinearLayout>



        <TextView
            android:id="@+id/periods_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_5sdp"
            android:fontFamily="@font/my_font_regular"
            android:text="3 periods"
            android:textColor="@color/head_color"
            android:textSize="@dimen/_11ssp"
            app:layout_constraintBottom_toBottomOf="@+id/linear"
            app:layout_constraintStart_toEndOf="@+id/linear"
            app:layout_constraintTop_toTopOf="@+id/linear" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/day_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:checked="true"
            android:elevation="@dimen/_3sdp"
            android:visibility="invisible"
            android:thumb="@drawable/switch_thumb_selector"
            app:layout_constraintEnd_toStartOf="@id/iv_collapse"
            app:layout_constraintTop_toTopOf="parent"
            app:track="@drawable/switch_selector" />

        <ImageView
            android:id="@+id/iv_collapse"
            android:layout_width="@dimen/_25sdp"
            android:layout_height="@dimen/_25sdp"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_14sdp"
            android:rotation="180"
            android:src="@drawable/down_arrow"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />



        <RelativeLayout
            android:id="@+id/add_period_btn"
            android:layout_width="0dp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginHorizontal="@dimen/_12sdp"
            android:layout_marginVertical="@dimen/_12sdp"
            android:layout_marginTop="@dimen/_19sdp"
            android:background="@drawable/bg_btn_blue"
            android:backgroundTint="@color/white"
            android:elevation="@dimen/_4sdp"
            android:padding="@dimen/_10sdp"
            android:textAllCaps="false"
            android:visibility="gone"
            app:cornerRadius="@dimen/_6sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/periods_rv"
            android:layout_marginBottom="@dimen/_12sdp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/text"
                android:src="@drawable/plus">

            </ImageView>

            <TextView
                android:id="@+id/text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_marginStart="@dimen/_4sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_marginEnd="@dimen/_2sdp"
                android:layout_marginBottom="@dimen/_2sdp"
                android:fontFamily="@font/avenir_medium"
                android:text="@string/add_new_period"
                android:textColor="@color/new_themeBlue_color"
                android:textSize="@dimen/_10ssp">

            </TextView>
        </RelativeLayout>

        <TextView
            android:id="@+id/add_period_btn1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            app:cornerRadius="@dimen/_4sdp"
            app:strokeWidth="@dimen/_1sdp"
            app:strokeColor="@color/new_themeBlue_color"
            android:backgroundTint="@color/white"
            android:fontFamily="@font/avenir_regular"
            android:gravity="center"
            android:textAllCaps="false"
            android:padding="@dimen/_10sdp"
            android:text="@string/add_period"
            android:textColor="@color/new_themeBlue_color"
            android:textSize="@dimen/_12ssp"
            android:visibility="gone"
            android:drawableStart="@drawable/plus"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"

            tools:ignore="MissingConstraints" />

        <include
            android:id="@+id/clinic_schedule_layout"
            layout="@layout/item_clinic_schedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_12sdp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/linear" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/periods_rv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_10sdp"
            android:visibility="gone"
            tools:itemCount="2"
            app:layout_constraintTop_toBottomOf="@id/linear" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>