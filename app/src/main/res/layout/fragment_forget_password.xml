<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_color_gray"
        >

        <ImageView
            android:id="@+id/imageView5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop"

            android:layout_marginBottom="6dp"
            app:layout_constraintBottom_toTopOf="@+id/forget_txv" />

        <include
            android:id="@+id/toolbar"
            android:visibility="gone"
            layout="@layout/authentication_toolbar" />


        <TextView
            android:id="@+id/forget_password_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_24sdp"
            android:drawableLeft="@drawable/ic_baseline_arrow_back_24"
            android:drawablePadding="@dimen/_6sdp"
            android:drawableTint="@color/black"
            android:fontFamily="@font/avenir_bold"
            android:text="@string/forget_passwords"
            android:textColor="@color/black"
            android:textSize="@dimen/_16ssp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_help"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_20sdp"
            android:background="@drawable/bg_btn_blue"
            android:backgroundTint="#E8E8FD"
            android:drawableLeft="@drawable/frame__2_"
            android:drawablePadding="@dimen/_6sdp"
            android:elevation="@dimen/_2sdp"
            android:fontFamily="@font/avenir_regular"
            android:paddingHorizontal="@dimen/_6sdp"
            android:paddingVertical="@dimen/_6sdp"
            android:text="@string/help"
            android:textColor="@color/new_themeBlue_color"
            android:textSize="@dimen/_10ssp"
            app:layout_constraintBottom_toBottomOf="@+id/forget_password_tv"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/forget_password_tv" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/tb_photo_bg"
            android:layout_width="@dimen/_70sdp"
            android:layout_height="@dimen/_70sdp"
            android:layout_marginTop="@dimen/_40sdp"
            android:visibility="gone"
            android:background="@drawable/photo_bg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/forget_password_tv" />

        <ImageView
            android:id="@+id/tb_photo_iv"
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:src="@drawable/ic_lock_black"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/tb_photo_bg"
            app:layout_constraintEnd_toEndOf="@id/tb_photo_bg"
            app:layout_constraintStart_toStartOf="@id/tb_photo_bg"
            app:layout_constraintTop_toTopOf="@id/tb_photo_bg" />

        <TextView
            android:id="@+id/welcome_txv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_20sdp"
            android:layout_marginTop="@dimen/_30sdp"
            android:fontFamily="@font/my_font_regular"
            android:gravity="center"
            android:visibility="gone"
            android:text="@string/forget_password_txt"
            android:textColor="@color/text_gray2"
            android:textSize="@dimen/_12ssp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tb_photo_bg" />


        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/email_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/phone_number_or_email"
            android:textSize="@dimen/_8ssp"
            android:layout_marginTop="@dimen/_15sdp"
            app:boxBackgroundMode="none"
            app:boxStrokeColor="@color/colorPrimary"
            app:hintTextColor="@color/new_gray_color"
            android:background="@drawable/bg_edittext"
            app:layout_constraintEnd_toEndOf="@+id/send_btn"
            app:layout_constraintStart_toStartOf="@+id/send_btn"
            app:layout_constraintTop_toBottomOf="@+id/forget_txv">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/email_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:background="@color/white"
                android:inputType="text" />

        </com.google.android.material.textfield.TextInputLayout>

        <RadioGroup
            android:id="@+id/radio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:layout_marginTop="15dp"
            android:visibility="gone"
            android:gravity="center_horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/email_layout"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radio_english"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:elevation="1dp"
                android:padding="5dp"
                android:background="@drawable/bg_chooselang_radiobtn"
                android:layout_marginBottom="20dp"
                android:text="@string/doctoraccount"
                android:layout_margin="5dp"
                android:layout_marginStart="15dp"
                android:textColor="@color/blue"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"/>

            <RadioButton
                android:id="@+id/radio_arabic"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="@string/polyclinicaccount"
                android:textSize="13sp"
                android:elevation="1dp"
                android:layout_margin="5dp"
                android:padding="5dp"
                android:background="@drawable/bg_chooselang_radiobtn"
                android:textColor="@color/blue"
                />
        </RadioGroup>

        <TextView
            android:id="@+id/forget_txv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_20sdp"
            android:layout_marginBottom="@dimen/_24sdp"
            android:layout_marginTop="@dimen/_15sdp"
            android:fontFamily="@font/avenir_regular"
            android:gravity="center"
            android:text="@string/now_you_will_receive_a_verification_code"
            android:textColor="@color/black"
            android:textSize="@dimen/_12ssp"
            app:layout_constraintEnd_toEndOf="@+id/email_layout"
            app:layout_constraintStart_toStartOf="@+id/email_layout"
            app:layout_constraintTop_toBottomOf="@+id/imageView13" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/send_btn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_50sdp"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:layout_marginBottom="@dimen/_16sdp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/new_themeBlue_color"
            android:fontFamily="@font/avenirs_semibold"
            android:gravity="center"
            android:text="@string/send_code"
            android:textAllCaps="false"
            android:textSize="@dimen/_12ssp"
            app:layout_constraintTop_toBottomOf="@+id/radio"
            tools:layout_editor_absoluteX="21dp" />


        <ImageView
            android:id="@+id/footer_bg"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginBottom="-40dp"
            android:src="@drawable/bg_solid_sky"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/for_support_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_20sdp"
            android:layout_marginTop="13dp"
            android:fontFamily="@font/my_font_bold"
            android:text="@string/for_support_call"
            android:visibility="gone"
            android:textColor="@color/head_color"
            android:textSize="@dimen/_16ssp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/footer_bg" />


        <TextView
            android:id="@+id/num_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:layout_marginEnd="@dimen/_20sdp"
            android:fontFamily="@font/my_font_bold"
            android:text="@string/_17143"
            android:visibility="gone"
            android:textColor="@color/white"
            android:drawablePadding="8dp"
            android:textSize="@dimen/_16ssp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/footer_bg"
            app:drawableStartCompat="@drawable/ic_phone" />

        <ImageView
            android:id="@+id/imageView13"
            android:layout_width="@dimen/_130sdp"
            android:layout_height="@dimen/_45sdp"
            android:layout_marginTop="@dimen/_90sdp"
            android:src="@drawable/ic_new_logo"
            app:layout_constraintEnd_toEndOf="@+id/forget_txv"
            app:layout_constraintStart_toStartOf="@+id/forget_txv"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>