<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="emrDetails"
            type="com.salamtak.domain.entities.response.NewPatientEmrdetail" />

        <variable
            name="parentPosition"
            type="java.lang.Integer" />

        <variable
            name="emrTitle"
            type="com.salamtak.domain.entities.response.EmrTitleData" />

        <variable
            name="positions"
            type="java.lang.Integer" />

        <!--        <variable-->
        <!--            name="emrDetails"-->
        <!--            type="com.salamtak.domain.entities.response.EmrDetailsData" />-->

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_patient_lobby"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="50dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/top_iv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/iv_collapse"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_120sdp"
                android:layout_margin="12dp"
                android:background="@drawable/bg_btn_border_gray_transprent">

                <LinearLayout
                    android:id="@+id/ll_photo_bg"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:layout_marginTop="@dimen/_8ssp"
                    android:background="@drawable/progress_bg_filled"
                    android:backgroundTint="#E8E8FD"
                    android:gravity="center"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/upload_photo_bg"
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:src="@drawable/group" />
                </LinearLayout>

                <TextView
                    android:id="@+id/clinic_name_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_6sdp"
                    android:fontFamily="@font/avenirs_semibold"
                    android:text="@{emrTitle.clinicName}"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_14ssp"
                    app:layout_constraintBottom_toBottomOf="@+id/ll_photo_bg"
                    app:layout_constraintStart_toEndOf="@+id/ll_photo_bg"
                    app:layout_constraintTop_toTopOf="@+id/ll_photo_bg"
                    tools:text="Clinic Name" />

                <LinearLayout
                    android:id="@+id/ll_call_iv"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:background="@drawable/progress_bg_filled"
                    android:backgroundTint="#E8E8FD"
                    android:gravity="center"
                    app:layout_constraintStart_toStartOf="@+id/ll_photo_bg"
                    app:layout_constraintTop_toBottomOf="@+id/ll_photo_bg">

                    <ImageView
                        android:id="@+id/call_iv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="4dp"
                        android:src="@drawable/new_category"
                        app:tint="@color/new_themeBlue_color" />
                </LinearLayout>


                <TextView
                    android:id="@+id/emr_type_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_6sdp"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/avenirs_semibold"
                    android:text="@{emrTitle.medicalExaminationTypeName}"
                    android:textColor="@color/hint_color"
                    android:textSize="@dimen/_8ssp"
                    app:layout_constraintBottom_toBottomOf="@+id/ll_call_iv"
                    app:layout_constraintStart_toEndOf="@id/ll_call_iv"
                    app:layout_constraintTop_toTopOf="@+id/ll_call_iv"
                    tools:text="Call" />

                <LinearLayout
                    android:id="@+id/ll_date_tv"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:background="@drawable/progress_bg_filled"
                    android:backgroundTint="#E8E8FD"
                    android:gravity="center"
                    app:layout_constraintBottom_toBottomOf="@+id/date_tv"
                    app:layout_constraintEnd_toStartOf="@+id/date_tv"
                    app:layout_constraintTop_toTopOf="@+id/date_tv">

                    <ImageView
                        android:id="@+id/iv_date_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="4dp"
                        android:src="@drawable/ic_small_calender"
                        app:tint="@color/new_themeBlue_color" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_iv_time"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:background="@drawable/progress_bg_filled"
                    android:backgroundTint="#E8E8FD"
                    android:gravity="center"
                    app:layout_constraintStart_toStartOf="@+id/ll_call_iv"
                    app:layout_constraintTop_toBottomOf="@+id/ll_call_iv">

                    <ImageView
                        android:id="@+id/iv_time"
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:padding="4dp"
                        android:src="@drawable/time_circle"
                        app:tint="@color/blue" />
                </LinearLayout>

                <TextView
                    android:id="@+id/emr_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_6sdp"
                    android:fontFamily="@font/avenirs_semibold"
                    convertAnthorTime="@{emrTitle.appountmentDate}"
                    android:textColor="@color/hint_color"
                    android:textSize="@dimen/_8ssp"
                    app:layout_constraintBottom_toBottomOf="@+id/ll_iv_time"
                    app:layout_constraintStart_toEndOf="@id/ll_call_iv"
                    app:layout_constraintTop_toTopOf="@+id/ll_iv_time" />

                <TextView
                    android:id="@+id/date_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:drawablePadding="4dp"
                    android:fontFamily="@font/avenirs_semibold"
                    android:gravity="center"
                    android:layout_marginEnd="10dp"
                    android:padding="4dp"
                    convertDateAnthor="@{emrTitle.appountmentDate}"
                    android:textColor="@color/hint_color"
                    android:textSize="@dimen/_8ssp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_collapse1"
                    app:layout_constraintEnd_toStartOf="@+id/iv_collapse1"
                    app:layout_constraintTop_toTopOf="@+id/iv_collapse1"
                    tools:text="20/2/2022" />

                <ImageView
                    android:id="@+id/iv_collapse1"
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:layout_marginHorizontal="@dimen/_10sdp"
                    android:src="@drawable/ic_down"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
