<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
            android:layout_width="match_parent"
        android:layout_height="match_parent"
      >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >
            <TextView
                android:id="@+id/tv_help"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_20sdp"
                android:background="@drawable/bg_btn_blue"
                android:backgroundTint="#E8E8FD"
                android:drawableLeft="@drawable/frame__2_"
                android:drawablePadding="@dimen/_6sdp"
                android:elevation="@dimen/_2sdp"
                android:fontFamily="@font/avenir_regular"
                android:paddingHorizontal="@dimen/_6sdp"
                android:paddingVertical="@dimen/_6sdp"
                android:text="@string/help"
                android:layout_marginTop="20dp"
                android:textColor="@color/new_themeBlue_color"
                android:textSize="@dimen/_10ssp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <RelativeLayout
                android:id="@+id/clinics_tv"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_40sdp"
                android:layout_marginHorizontal="@dimen/_12sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tv_editClinicstxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:drawablePadding="@dimen/_6sdp"
                    android:drawableStart="@drawable/group_70328"
                    android:fontFamily="@font/avenir_bold"
                    android:text="@string/clinic_schedule"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11ssp">

                </TextView>
                <ImageView
                    android:id="@+id/help2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/help"
                    android:padding="@dimen/_2sdp"
                    android:visibility="gone"
                    android:layout_alignParentBottom="true"/>
                <TextView
                    android:id="@+id/tv_Clinicprofile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:drawablePadding="@dimen/_6sdp"
                    android:fontFamily="@font/avenir_bold"
                    android:layout_alignParentStart="true"
                    android:text="@string/clinic_profile"
                    android:visibility="gone"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_16ssp"/>


                <TextView
                    android:id="@+id/tv_saveedit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentEnd="true"
                    android:fontFamily="@font/avenir_bold"
                    android:text="@string/save_edit"
                    android:visibility="gone"
                    android:textColor="@color/new_themeBlue_color"
                    android:textSize="@dimen/_10ssp">

                </TextView>

            </RelativeLayout>

            <com.kofigyan.stateprogressbar.StateProgressBar
                android:id="@+id/your_state_progress_bar_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_marginTop="@dimen/_25sdp"
                android:layout_marginHorizontal="@dimen/_16sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/clinics_tv"
                app:spb_animateToCurrentProgressState="true"
                app:spb_checkStateCompleted="true"
                android:textSize="@dimen/_4ssp"
                android:visibility="gone"
                app:spb_currentStateNumber="one"
                app:spb_maxStateNumber="four"
                app:spb_currentStateDescriptionColor="@color/new_themeBlue_color"
                app:spb_stateBackgroundColor="#BDBDBD"
                app:spb_stateDescriptionColor="#AEB3BE"
                app:spb_stateForegroundColor="@color/new_themeBlue_color"
                app:spb_stateNumberBackgroundColor="#AEB3BE"
                app:spb_stateNumberForegroundColor="#eeeeee" />

            <RadioGroup
                android:id="@+id/steps_radio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_marginTop="@dimen/_25sdp"
                android:weightSum="5"
                android:layout_marginHorizontal="@dimen/_2sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/clinics_tv">

                <androidx.appcompat.widget.AppCompatRadioButton
                    android:id="@+id/info_rb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_2sdp"
                    android:layout_weight="1"
                    android:background="@drawable/choose_selector_language"
                    android:button="@null"
                    android:gravity="center"
                    android:padding="@dimen/_2sdp"
                    android:text="@string/info_clinic"
                    android:textColor="@color/choose_selector"
                    android:textSize="@dimen/_8ssp"
                    android:fontFamily="@font/avenir_medium"  />

                <androidx.appcompat.widget.AppCompatRadioButton
                    android:id="@+id/location_rb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_2sdp"
                    android:layout_weight="1"
                    android:background="@drawable/choose_selector_language"
                    android:button="@null"
                    android:gravity="center"
                    android:padding="@dimen/_2sdp"
                    android:text="@string/location"
                    android:textColor="@color/choose_selector"
                    android:textSize="@dimen/_8ssp"
                    android:fontFamily="@font/avenir_medium"  />


                <androidx.appcompat.widget.AppCompatRadioButton
                    android:id="@+id/schedule_rb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_2sdp"
                    android:layout_weight="1"
                    android:background="@drawable/choose_selector_language"
                    android:button="@null"
                    android:checked="true"
                    android:gravity="center"
                    android:padding="@dimen/_2sdp"
                    android:text="@string/schedule"
                    android:textColor="@color/choose_selector"
                    android:textSize="@dimen/_8ssp"
                    android:fontFamily="@font/avenir_medium"  />

                <androidx.appcompat.widget.AppCompatRadioButton
                    android:id="@+id/vaction_rb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_2sdp"
                    android:layout_weight="1"
                    android:background="@drawable/choose_selector_language"
                    android:button="@null"
                    android:gravity="center"
                    android:padding="@dimen/_2sdp"
                    android:text="@string/not_available"
                    android:textColor="@color/choose_selector"
                    android:textSize="@dimen/_8ssp"
                    android:fontFamily="@font/avenir_medium"  />

                <androidx.appcompat.widget.AppCompatRadioButton
                    android:id="@+id/gallery_rb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_2sdp"
                    android:layout_weight="1"
                    android:background="@drawable/choose_selector_language"
                    android:button="@null"
                    android:gravity="center"
                    android:padding="@dimen/_2sdp"
                    android:text="@string/gallery"
                    android:textColor="@color/choose_selector"
                    android:textSize="@dimen/_8ssp"
                    android:fontFamily="@font/avenir_medium"/>

            </RadioGroup>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_below="@+id/layout_group">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingBottom="@dimen/_10sdp">

                <include
                    android:id="@+id/toolbar"
                    layout="@layout/authentication_toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_70sdp"
                    android:elevation="@dimen/_5sdp"
                    android:visibility="gone" />

                <include
                    android:id="@+id/clinic_toolbar"
                    layout="@layout/clinic_toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_80sdp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/toolbar" />


                <TextView
                    android:id="@+id/tv_logout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_5sdp"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:elevation="@dimen/_2sdp"
                    android:fontFamily="@font/my_font_semibold"
                    android:letterSpacing=".02"
                    android:lineSpacingExtra="1dp"
                    android:paddingHorizontal="@dimen/_15sdp"
                    android:paddingVertical="@dimen/_10sdp"
                    android:text="@string/logout"
                    android:visibility="gone"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_11ssp"
                    app:layout_constraintBottom_toBottomOf="@id/toolbar"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/toolbar" />


                <include
                    android:id="@+id/services_tb"
                    layout="@layout/services_toolbar"
                    android:layout_width="match_parent"
                    android:visibility="gone"
                    android:layout_marginHorizontal="@dimen/_12sdp"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/tv_logout" />
                 <TextView
                     android:id="@+id/tv_nila"
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:layout_marginTop="10dp"
                     android:paddingTop="10dp"
                     android:text="@string/set_your_ongoing_clinic_schedule"
                     app:layout_constraintStart_toStartOf="parent"
                     app:layout_constraintEnd_toEndOf="parent"
                     app:layout_constraintBottom_toTopOf="@+id/schedule_rv"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/schedule_rv"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_margin="@dimen/_5sdp"
                    android:paddingBottom="30dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_nila"
                    />
                <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <include
                    android:id="@+id/profile_bottom_toolbar"
                    layout="@layout/bottom_tb_layout"
                    android:layout_width="match_parent"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@+id/schedule_rv"
                    android:layout_height="@dimen/_70sdp"
                    app:layout_constraintBottom_toBottomOf="parent" />


            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/submitSchedule"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_42sdp"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_marginTop="@dimen/_3sdp"
            android:layout_marginEnd="@dimen/_12sdp"
            android:layout_marginBottom="@dimen/_3sdp"
            android:backgroundTint="@color/new_themeBlue_color"
            android:fontFamily="@font/avenir_bold"
            android:gravity="center"
            android:text="@string/next_"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            app:cornerRadius="@dimen/_6sdp" />
    </RelativeLayout>

</layout>