<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">


                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/profile_doctor_image"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/guideline_horizontal"
                    tools:src="@drawable/image_placeholder"
                    />

                <TextView
                    android:id="@+id/tv_greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:fontFamily="@font/avenir_regular"
                    android:text="Good Morning"
                    android:textColor="@color/hint_color"
                    android:textSize="@dimen/_12ssp"
                    app:layout_constraintStart_toEndOf="@+id/profile_doctor_image"
                    app:layout_constraintTop_toTopOf="@+id/profile_doctor_image" />

                <ImageView
                    android:id="@+id/imageView12"
                    android:layout_width="@dimen/_10sdp"
                    android:layout_height="@dimen/_10sdp"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:src="@drawable/hi"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_greeting"
                    app:layout_constraintStart_toEndOf="@+id/tv_greeting"
                    app:layout_constraintTop_toTopOf="@+id/guideline_horizontal" />

                <TextView
                    android:id="@+id/desc_name_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/avenirs_semibold"
                    android:text="@string/hello_dr"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11ssp"
                    app:layout_constraintStart_toEndOf="@+id/profile_doctor_image"
                    app:layout_constraintTop_toBottomOf="@+id/tv_greeting" />

                <TextView
                    android:id="@+id/user_name_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/avenirs_semibold"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11ssp"
                    app:layout_constraintStart_toEndOf="@id/desc_name_tv"
                    app:layout_constraintTop_toBottomOf="@+id/tv_greeting"
                    tools:text="" />

                <View
                    android:id="@+id/viewMsg"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_52sdp"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    android:layout_marginTop="21dp"
                    android:background="@drawable/bg_light_gray_solid"
                    android:backgroundTint="#E8E8FD"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/profile_doctor_image" />

                <ImageView
                    android:id="@+id/imageView10"
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:src="@drawable/handlike"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@+id/viewMsg"
                    app:layout_constraintStart_toStartOf="@+id/viewMsg"
                    app:layout_constraintTop_toTopOf="@+id/viewMsg" />

                <TextView
                    android:id="@+id/tv_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/avenirs_semibold"
                    android:text="@string/thank_you_for_registering_in_salamtak"
                    android:textColor="@color/new_themeBlue_color"
                    android:textSize="@dimen/_11ssp"
                    android:visibility="gone"
                    app:layout_constraintStart_toEndOf="@+id/imageView10"
                    app:layout_constraintTop_toTopOf="@+id/imageView10" />

                <TextView
                    android:id="@+id/tv_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/avenir_regular"
                    android:text="@string/your_account_will_be_activated_as_soon_as_possible"
                    android:textColor="@color/new_themeBlue_color"
                    android:textSize="@dimen/_8ssp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@+id/imageView10"
                    app:layout_constraintEnd_toEndOf="@+id/viewMsg"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toEndOf="@+id/imageView10" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/rl_image"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/_6sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/viewMsg">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.viewpager.widget.ViewPager
                            android:id="@+id/view_pager"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:overScrollMode="never"
                            android:visibility="gone" />

                        <com.google.android.material.tabs.TabLayout
                            android:id="@+id/tab_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:layout_centerHorizontal="true"
                            android:layout_marginHorizontal="@dimen/_18sdp"
                            android:layout_marginBottom="-10dp"
                            android:background="@color/transparent"
                            app:tabBackground="@drawable/tab_selector"
                            app:tabGravity="center"
                            app:tabIndicatorColor="@color/white"
                            app:tabIndicatorHeight="0dp" />

                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>
                <ImageView
                    android:id="@+id/advertising"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:src="@drawable/salamtad_advertising"
                    android:elevation="@dimen/_5sdp"
                    android:layout_marginTop="45dp"
                    android:adjustViewBounds="true"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="18dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/rl_image"
                    />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/_10sdp"
                    app:layout_constraintEnd_toStartOf="@+id/end_guid_line"
                    app:layout_constraintStart_toStartOf="@+id/start_guid_line"
                    app:layout_constraintTop_toBottomOf="@+id/advertising">


                    <TextView
                        android:id="@+id/date_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_6sdp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/otp_border"
                        android:elevation="@dimen/_1sdp"
                        android:fontFamily="@font/avenir_bold"
                        android:gravity="start"
                        android:hint="@string/select_period_of_date"
                        android:padding="@dimen/_10sdp"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_12ssp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.466"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/to_date_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/otp_border"
                        android:hint="dd/MM/YYYY"
                        android:padding="6dp"
                        android:textColor="@color/head_color"
                        android:textSize="14sp"
                        android:visibility="gone"
                        app:layout_constraintEnd_toStartOf="@id/done_tv"
                        app:layout_constraintTop_toTopOf="@+id/done_tv" />


                    <ImageView
                        android:id="@+id/done_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:elevation="@dimen/_1sdp"
                        android:src="@drawable/ic_calendar_home"
                        app:layout_constraintBottom_toBottomOf="@+id/date_tv"
                        app:layout_constraintEnd_toStartOf="@+id/iv_Del"
                        app:layout_constraintTop_toTopOf="@+id/date_tv" />

                    <ImageView
                        android:id="@+id/iv_Del"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="@dimen/_8sdp"
                        android:elevation="@dimen/_1sdp"
                        android:src="@drawable/ic_delete"
                        app:layout_constraintBottom_toBottomOf="@+id/date_tv"
                        app:layout_constraintEnd_toEndOf="@+id/date_tv"
                        app:layout_constraintTop_toTopOf="@+id/date_tv" />

                    <ImageView
                        android:id="@+id/new_circel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="-85dp"
                        android:layout_marginEnd="12dp"
                        android:scaleType="fitXY"
                        android:src="@drawable/ic_new_subtract"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <LinearLayout
                        android:id="@+id/ll_cases"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/statistics_tv">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="@dimen/_6ssp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_border_gray_transprent"
                            android:backgroundTint="@color/blue"
                            android:orientation="vertical"
                            android:paddingVertical="@dimen/_12sdp">

                            <TextView
                                android:id="@+id/first_circel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:fontFamily="@font/avenir_bold"
                                android:text="0"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_22sdp" />

                            <TextView
                                android:id="@+id/first_desc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="@dimen/_10ssp"
                                android:fontFamily="@font/avenir_regular"
                                android:gravity="center"
                                android:text="@string/upcaoming_ncases"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_10ssp"

                                />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="@dimen/_6ssp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_border_gray_transprent"
                            android:backgroundTint="#E8F3E8"
                            android:orientation="vertical"
                            android:paddingVertical="@dimen/_12sdp">

                            <TextView
                                android:id="@+id/middel_circel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:fontFamily="@font/avenir_bold"
                                android:text="0"
                                android:textColor="#0DA500"
                                android:textSize="@dimen/_22sdp" />

                            <TextView
                                android:id="@+id/middel_desc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="@dimen/_10ssp"
                                android:fontFamily="@font/avenir_regular"
                                android:gravity="center"
                                android:text="@string/total_ncases"
                                android:textColor="#0DA500"
                                android:textSize="@dimen/_10ssp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_margin="@dimen/_6ssp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_btn_border_gray_transprent"
                            android:backgroundTint="#ECEDF2"
                            android:orientation="vertical"
                            android:paddingVertical="@dimen/_12sdp">

                            <TextView
                                android:id="@+id/last_circel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:fontFamily="@font/avenir_bold"
                                android:text="0"
                                android:textColor="#8088A4"
                                android:textSize="@dimen/_22sdp" />

                            <TextView
                                android:id="@+id/last_desc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="@dimen/_10ssp"
                                android:fontFamily="@font/avenir_regular"
                                android:gravity="center"
                                android:lines="2"
                                android:text="@string/today_ncases"
                                android:textColor="#8088A4"
                                android:textSize="@dimen/_10ssp" />
                        </LinearLayout>
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/clinics_home_rv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/ll_cases"
                        tools:itemCount="1"
                        tools:listitem="@layout/item_home_clinic" />

                    <TextView
                        android:id="@+id/statistics_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="15dp"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:text="@string/all_booking"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_14ssp"
                        android:visibility="visible"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/date_tv" />

                    <TextView
                        android:id="@+id/tv_clinics"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_btn_blue"
                        android:backgroundTint="#E8E8FD"
                        android:drawablePadding="@dimen/_6sdp"
                        android:fontFamily="@font/avenir_regular"
                        android:gravity="center_horizontal"
                        android:paddingHorizontal="@dimen/_6sdp"
                        android:paddingVertical="@dimen/_6sdp"
                        android:text="@string/all_clinics"
                        android:textColor="@color/new_themeBlue_color"
                        android:textSize="@dimen/_10ssp"
                        app:drawableEndCompat="@drawable/ic_down_arrow_blue"
                        app:layout_constraintBottom_toBottomOf="@+id/statistics_tv"
                        app:layout_constraintEnd_toStartOf="@id/tv_listofDoctors"
                        app:layout_constraintStart_toEndOf="@+id/statistics_tv"
                        app:layout_constraintTop_toTopOf="@+id/statistics_tv" />

                    <TextView
                        android:id="@+id/tv_listofDoctors"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_btn_blue"
                        android:backgroundTint="#E8E8FD"
                        android:drawablePadding="@dimen/_6sdp"
                        android:fontFamily="@font/avenir_regular"
                        android:gravity="center_horizontal"
                        android:paddingHorizontal="@dimen/_6sdp"
                        android:paddingVertical="@dimen/_6sdp"
                        android:text="@string/alldoctors"
                        android:textColor="@color/new_themeBlue_color"
                        android:textSize="@dimen/_10ssp"
                        android:visibility="gone"
                        app:drawableEndCompat="@drawable/ic_down_arrow_blue"
                        app:layout_constraintBottom_toBottomOf="@+id/statistics_tv"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tv_clinics"
                        app:layout_constraintTop_toTopOf="@+id/statistics_tv" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/statics_rv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_23sdp"
                        android:visibility="visible"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:layout_constraintBottom_toTopOf="@+id/whats_up_rv"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/ll_cases"
                        app:layout_constraintVertical_bias="0.0"
                        tools:itemCount="2"
                        tools:listitem="@layout/item_static" />
                    <TextView
                        android:id="@+id/salamtak_gate_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="15dp"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:text="@string/salamtak_gate"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_14ssp"
                        android:visibility="visible"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/statics_rv" />
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/whats_up_rv"
                        android:layout_width="0dp"
                        android:layout_height="300dp"
                        android:layout_marginTop="@dimen/_15sdp"
                        android:visibility="visible"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/salamtak_gate_tv"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintVertical_bias="0.0"
                        tools:itemCount="2"
                        tools:listitem="@layout/item_layout_gates" />

                    <ProgressBar
                        android:id="@+id/progress_bar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminateTint="@color/color_primary"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="@+id/whats_up_rv"
                        app:layout_constraintEnd_toEndOf="@+id/whats_up_rv"
                        app:layout_constraintStart_toStartOf="@+id/whats_up_rv"
                        app:layout_constraintTop_toTopOf="@+id/whats_up_rv" />

                </androidx.constraintlayout.widget.ConstraintLayout>


                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/start_guid_line"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.03" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/end_guid_line"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.97" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_percent="0.02" />

                <ImageView
                    android:id="@+id/iv_notification"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintBottom_toBottomOf="@+id/user_name_tv"
                    app:layout_constraintEnd_toStartOf="@+id/end_guid_line"
                    app:layout_constraintTop_toTopOf="@+id/tv_greeting"
                    app:srcCompat="@drawable/ic_notification" />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/iv_message"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@+id/user_name_tv"
                    app:layout_constraintEnd_toStartOf="@+id/iv_notification"
                    app:layout_constraintTop_toTopOf="@+id/tv_greeting"
                    app:lottie_autoPlay="false"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/alarm" />

                <ImageView
                    android:id="@+id/iv_roundbg"
                    android:layout_width="20dp"
                    android:layout_height="15dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="7dp"
                    app:layout_constraintBottom_toTopOf="@+id/iv_notification"
                    app:layout_constraintStart_toStartOf="@+id/iv_notification"
                    app:layout_constraintTop_toTopOf="@+id/iv_notification"
                    app:srcCompat="@drawable/red_round_bg" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_numberOfNotification"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_roundbg"
                    app:layout_constraintEnd_toEndOf="@+id/iv_roundbg"
                    app:layout_constraintStart_toStartOf="@id/iv_roundbg"
                    app:layout_constraintTop_toTopOf="@+id/iv_roundbg" />

                <ImageView
                    android:id="@+id/iv_messageroundbg"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginStart="16dp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toTopOf="@+id/iv_message"
                    app:layout_constraintStart_toStartOf="@+id/iv_message"
                    app:layout_constraintTop_toTopOf="@+id/iv_message"
                    app:layout_constraintVertical_bias="0.0"
                    app:srcCompat="@drawable/red_round_bg" />


            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        android:id="@+id/layoutBottomsheetpersistant"
        layout="@layout/layout_bottomsheet_alldoctors"
        android:visibility="gone" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>