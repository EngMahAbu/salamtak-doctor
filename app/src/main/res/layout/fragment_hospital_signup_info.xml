<?xml version="1.0" encoding="utf-8"?>
<!-- Hospital sign-up step 2 of 2: Hospital Info (every field required) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_color_gray">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/avenir_bold"
        android:text="@string/hospital_title"
        android:textColor="@color/black"
        android:textSize="@dimen/_16ssp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_help"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_btn_blue"
        android:backgroundTint="#E8E8FD"
        android:drawablePadding="@dimen/_6sdp"
        android:fontFamily="@font/avenir_regular"
        android:paddingHorizontal="@dimen/_6sdp"
        android:paddingVertical="@dimen/_6sdp"
        android:text="@string/help"
        android:textColor="@color/new_themeBlue_color"
        android:textSize="@dimen/_10ssp"
        app:drawableStartCompat="@drawable/frame__2_"
        app:layout_constraintBottom_toBottomOf="@id/tv_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_title" />

    <com.kofigyan.stateprogressbar.StateProgressBar
        android:id="@+id/stepper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:spb_animateToCurrentProgressState="true"
        app:spb_checkStateCompleted="true"
        app:spb_currentStateDescriptionColor="@color/blue"
        app:spb_currentStateNumber="two"
        app:spb_descriptionTopSpaceIncrementer="8dp"
        app:spb_maxStateNumber="two"
        app:spb_stateBackgroundColor="#BDBDBD"
        app:spb_stateDescriptionColor="#AEB3BE"
        app:spb_stateDescriptionSize="12sp"
        app:spb_stateForegroundColor="@color/green"
        app:spb_stateNumberBackgroundColor="@color/blue"
        app:spb_stateNumberForegroundColor="@color/blue" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        app:layout_constraintBottom_toTopOf="@id/btn_next"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/stepper">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_name_en"
                style="@style/HospitalFieldLayout"
                android:hint="@string/hospital_name_en"
                app:errorIconDrawable="@drawable/ic_error_info">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_name_en"
                    style="@style/HospitalFieldEdit" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_name_ar"
                style="@style/HospitalFieldLayout"
                android:hint="@string/hospital_name_ar"
                app:errorIconDrawable="@drawable/ic_error_info">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_name_ar"
                    style="@style/HospitalFieldEdit" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_commercial_no"
                style="@style/HospitalFieldLayout"
                android:hint="@string/hospital_commercial_no"
                app:errorIconDrawable="@drawable/ic_error_info">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_commercial_no"
                    style="@style/HospitalFieldEdit"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_tax_no"
                style="@style/HospitalFieldLayout"
                android:hint="@string/hospital_tax_card_no"
                app:errorIconDrawable="@drawable/ic_error_info">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_tax_no"
                    style="@style/HospitalFieldEdit"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_phone"
                style="@style/HospitalFieldLayout"
                android:hint="@string/hospital_phone"
                app:errorIconDrawable="@drawable/ic_error_info">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_phone"
                    style="@style/HospitalFieldEdit"
                    android:inputType="phone"
                    android:maxLength="11" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tv_city"
                style="@style/HospitalPickerField"
                android:hint="@string/choose_city" />

            <TextView
                android:id="@+id/tv_area"
                style="@style/HospitalPickerField"
                android:hint="@string/choose_area" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_street"
                style="@style/HospitalFieldLayout"
                android:hint="@string/street_and_landmark"
                app:errorIconDrawable="@drawable/ic_error_info">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_street"
                    style="@style/HospitalFieldEdit" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tv_services"
                style="@style/HospitalPickerField"
                android:hint="@string/hospital_services"
                android:maxLines="3" />

            <TextView
                android:id="@+id/tv_insurance"
                style="@style/HospitalPickerField"
                android:hint="@string/hospital_insurance"
                android:maxLines="3" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_bio_en"
                style="@style/HospitalFieldLayout"
                android:hint="@string/hospital_bio_en"
                app:counterEnabled="true"
                app:counterMaxLength="500"
                app:errorIconDrawable="@drawable/ic_error_info">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_bio_en"
                    style="@style/HospitalFieldEdit"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:maxLength="500"
                    android:maxLines="6"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_bio_ar"
                style="@style/HospitalFieldLayout"
                android:hint="@string/hospital_bio_ar"
                app:counterEnabled="true"
                app:counterMaxLength="500"
                app:errorIconDrawable="@drawable/ic_error_info">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_bio_ar"
                    style="@style/HospitalFieldEdit"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:maxLength="500"
                    android:maxLines="6"
                    android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/HospitalSectionTitle"
                android:text="@string/hospital_front_tax_card_image" />

            <include
                android:id="@+id/tax_card"
                layout="@layout/doc_uploading_image_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_next"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="@color/hint_color"
        android:enabled="false"
        android:fontFamily="@font/avenir_bold"
        android:text="@string/hospital_next"
        android:textAllCaps="false"
        android:textColor="@color/white"
        app:cornerRadius="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:indeterminateTint="@color/new_themeBlue_color"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
