<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomnav"
        android:layout_marginBottom="5dp"
        android:paddingBottom="5dp"
        android:background="@color/colorBackground">


        <androidx.core.widget.NestedScrollView
            android:id="@+id/appointments_scroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1.0">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <include
                    android:id="@+id/background_gray_toolbar"
                    layout="@layout/appointment_toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="10dp"
                    android:visibility="visible"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_queue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="12dp"
                    android:backgroundTint="@color/color_primary"
                    android:fontFamily="@font/avenir_bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="8dp"
                    android:text="@string/queue"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_12ssp"
                    app:cornerRadius="50dp"
                    app:icon="@drawable/ic_queue_people"
                    app:iconPadding="8dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/white"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/background_gray_toolbar" />

<!--                android:id="@+id/filter_iv"-->

                <EditText
                     android:id="@+id/search"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginTop="15dp"
                    android:background="@drawable/bg_btn_border_gray_transprent"
                    android:drawableStart="@drawable/ic_search2"
                    android:drawablePadding="8dp"
                    android:drawableTint="#CDCDCD"
                    android:fontFamily="@font/avenir_regular"
                    android:hint="@string/search_by_patient_name"
                    android:imeOptions="flagNoEnterAction"
                    android:textSize="12sp"
                    android:lines="1"
                    android:maxLines="1"
                    android:padding="10dp"
                    android:singleLine="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.483"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btn_queue" />

                <LinearLayout
                    android:id="@+id/linearLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="12sp"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    app:layout_constraintEnd_toEndOf="@+id/search"
                    app:layout_constraintStart_toStartOf="@+id/search"
                    app:layout_constraintTop_toBottomOf="@+id/search">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/date_tv"
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:layout_marginEnd="3dp"
                        android:layout_weight="1"
                        android:backgroundTint="#EBFAF9"
                        android:padding="2dp"
                        android:visibility="visible"
                        app:cardCornerRadius="@dimen/_4sdp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="2dp">

                            <TextView
                                android:id="@+id/textdate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="5dp"
                                android:layout_marginEnd="4dp"
                                android:layout_toStartOf="@+id/ivFlaticon_calender"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:fontFamily="@font/avenir_bold"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_10ssp"
                                android:visibility="visible"
                                android:text="@string/select_peroid_of_date" />

                            <ImageView
                                android:id="@+id/ivFlaticon_calender"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:layout_marginEnd="3dp"
                                android:background="@drawable/calendar">

                            </ImageView>

                        </RelativeLayout>


                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/filter_iv"
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:layout_marginStart="3dp"
                        android:layout_weight="1"
                        android:backgroundTint="#E8E8FD"
                        android:visibility="visible"
                        app:cardCornerRadius="@dimen/_4sdp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="2dp">

                            <TextView
                                android:id="@+id/services"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true"
                                android:layout_gravity="center"
                                android:layout_marginStart="6dp"
                                android:layout_marginEnd="4dp"
                                android:layout_toStartOf="@+id/ivFlaticon_filter"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:fontFamily="@font/avenir_bold"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_10ssp"
                                android:visibility="visible"
                                android:text="@string/filter_clinic_services" />

                            <ImageView
                                android:id="@+id/ivFlaticon_filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/ic_filter">

                            </ImageView>


                        </RelativeLayout>


                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
                <LinearLayout
                    android:id="@+id/linearLayout2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    app:layout_constraintEnd_toEndOf="@+id/linearLayout"
                    app:layout_constraintStart_toStartOf="@+id/linearLayout"
                    app:layout_constraintTop_toBottomOf="@+id/linearLayout">
                    <TextView
                        android:id="@+id/tv_clinics"
                        android:layout_width="wrap_content"
                        android:layout_height="35dp"
                        android:background="@drawable/bg_btn_blue"
                        android:backgroundTint="#E8E8FD"
                        android:layout_marginEnd="10dp"
                        android:drawablePadding="6dp"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/avenir_bold"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="6dp"
                        android:text="@string/all_clinics"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:textColor="@color/new_themeBlue_color"
                        android:textSize="10sp"
                        app:layout_constraintStart_toEndOf="@+id/statistics_tv"
                        app:layout_constraintBottom_toBottomOf="@+id/statistics_tv"
                        app:layout_constraintEnd_toStartOf="@id/tv_listofDoctors"
                        app:layout_constraintTop_toTopOf="@+id/statistics_tv"
                        app:drawableEndCompat="@drawable/ic_down_arrow_blue"/>

                    <TextView
                        android:id="@+id/tv_listofDoctors"
                        android:layout_width="wrap_content"
                        android:layout_height="35dp"
                        android:background="@drawable/bg_btn_blue"
                        android:backgroundTint="#E8E8FD"
                        android:drawablePadding="6dp"
                        android:fontFamily="@font/avenir_bold"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="6dp"
                        android:text="@string/alldoctors"
                        android:layout_marginEnd="10dp"
                        android:visibility="visible"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:textColor="@color/new_themeBlue_color"
                        android:textSize="10sp"
                        app:layout_constraintStart_toEndOf="@+id/tv_clinics"
                        app:layout_constraintBottom_toBottomOf="@+id/statistics_tv"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/statistics_tv"
                        app:drawableEndCompat="@drawable/ic_down_arrow_blue"/>


                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/appointmentRv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:clipToPadding="false"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/linearLayout2"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_appointment" />

                <!-- Shown while the next page of appointments loads -->
                <ProgressBar
                    android:id="@+id/appointments_load_more"
                    android:layout_width="@dimen/_25sdp"
                    android:layout_height="@dimen/_25sdp"
                    android:layout_marginVertical="@dimen/_10sdp"
                    android:indeterminateTint="@color/new_themeBlue_color"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/appointmentRv" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>


                <RadioGroup
                    android:id="@+id/status_radio"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:ignore="MissingConstraints">

                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/current_rb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:layout_weight="0.5"
                        android:background="@drawable/choose_selector"
                        android:button="@null"
                        android:checked="true"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="@string/current"
                        android:textColor="@color/choose_selector"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/history_rb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="4dp"
                        android:layout_weight="0.5"
                        android:background="@drawable/choose_selector"
                        android:button="@null"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="@string/history"
                        android:textColor="@color/choose_selector"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </RadioGroup>



                <androidx.viewpager.widget.ViewPager
                    android:id="@+id/view_pager"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_marginTop="6dp"
                    app:layout_constraintHorizontal_bias="0.0"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@+id/status_radio"
                    tools:ignore="MissingConstraints" />

                <androidx.core.widget.NestedScrollView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/view_pager"
                    tools:ignore="MissingConstraints">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <TextView
                            android:id="@+id/filter_iv1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="4dp"
                            android:text="@string/filter"
                            android:textColor="@color/head_color"
                            android:visibility="gone"
                            app:drawableStartCompat="@drawable/ic_filter"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/calender_iv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/ic_new_calender_home"
                            android:textColor="@color/head_color"
                            android:textSize="14sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/filter_iv1" />

                        <TextView
                            android:id="@+id/from_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginTop="5dp"
                            android:fontFamily="@font/my_font_bold"
                            android:text="@string/From"
                            android:textColor="@color/sky_main"
                            android:textSize="18sp"
                            app:layout_constraintEnd_toStartOf="@id/to_tv"
                            app:layout_constraintStart_toEndOf="@id/calender_iv"
                            app:layout_constraintTop_toBottomOf="@id/filter_iv1" />

                        <TextView
                            android:id="@+id/to_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginTop="5dp"
                            android:fontFamily="@font/my_font_bold"
                            android:text="@string/to"
                            android:textColor="@color/sky_main"
                            android:textSize="18sp"
                            app:layout_constraintEnd_toStartOf="@id/done_tv"
                            app:layout_constraintStart_toEndOf="@id/date_tv1"
                            app:layout_constraintTop_toBottomOf="@id/filter_iv1" />

                        <TextView
                            android:id="@+id/datee_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:fontFamily="@font/my_font_bold"
                            android:text="@string/date"
                            android:textColor="@color/sky_main"
                            android:textSize="18sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/calender_iv" />


                        <TextView
                            android:id="@+id/date_tv1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/otp_border"
                            android:hint="dd/MM/YYYY"
                            android:padding="6dp"
                            android:textColor="@color/head_color"
                            android:textSize="14sp"
                            app:layout_constraintEnd_toStartOf="@id/to_date_tv"
                            app:layout_constraintStart_toEndOf="@id/datee_tv"
                            app:layout_constraintTop_toBottomOf="@id/from_tv"
                            tools:ignore="NotSibling" />

                        <TextView
                            android:id="@+id/to_date_tv1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/otp_border"
                            android:hint="dd/MM/YYYY"
                            android:padding="6dp"
                            android:textColor="@color/head_color"
                            android:textSize="14sp"
                            app:layout_constraintEnd_toStartOf="@id/done_tv"
                            app:layout_constraintStart_toEndOf="@id/date_tv1"
                            app:layout_constraintTop_toBottomOf="@id/to_tv" />

                        <ImageView
                            android:id="@+id/done_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_btn_blue"
                            android:padding="6dp"
                            android:src="@drawable/ic_new_serch_home"
                            android:textColor="@color/head_color"
                            android:textSize="14sp"
                            app:layout_constraintBottom_toBottomOf="@id/to_date_tv1"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/to_date_tv1"
                            app:layout_constraintTop_toBottomOf="@id/filter_iv1" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/clinics_home_rv"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/datee_tv"
                            tools:itemCount="1"
                            tools:listitem="@layout/item_home_clinic" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/statics_rv"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/clinics_home_rv"
                            tools:itemCount="1"
                            tools:listitem="@layout/item_new_spinner" />





                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.core.widget.NestedScrollView>

                <include
                    android:id="@+id/empty_page_layout"
                    layout="@layout/layout_empty_page"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/status_radio" />

    </androidx.constraintlayout.widget.ConstraintLayout>


  <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/bottomnav"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintBottom_toBottomOf="parent">
      <androidx.constraintlayout.widget.ConstraintLayout
          android:id="@+id/appointments"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          app:layout_constraintEnd_toStartOf="@+id/statistics"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintStart_toStartOf="parent">
      <com.google.android.material.imageview.ShapeableImageView
          android:id="@+id/serviceimage"
          android:layout_width="25dp"
          android:layout_height="25dp"
          android:src="@drawable/calendarblue"
          android:adjustViewBounds="true"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_toRightOf="@+id/serviceimage"
          android:text="@string/appointments"
          android:textColor="@color/black"
          android:textSize="10sp"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintBottom_toBottomOf="parent"
          android:layout_marginBottom="10dp"
          app:layout_constraintTop_toBottomOf="@+id/serviceimage"
          android:fontFamily="@font/avenir_medium"
          android:layout_centerVertical="true"
          android:layout_marginStart="6dp"/>
      </androidx.constraintlayout.widget.ConstraintLayout>
      <androidx.constraintlayout.widget.ConstraintLayout
          android:id="@+id/statistics"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          app:layout_constraintStart_toEndOf="@+id/appointments"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintBottom_toBottomOf="parent"
          app:layout_constraintEnd_toEndOf="parent">
          <com.google.android.material.imageview.ShapeableImageView
              android:id="@+id/statisctics"
              android:layout_width="22dp"
              android:layout_height="22dp"
              android:adjustViewBounds="true"
              android:src="@drawable/chart_app"
              app:tint="@color/gray"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toTopOf="parent"
              />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/statistics"
              android:textColor="@color/black"
              android:textSize="10sp"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintBottom_toBottomOf="parent"
              android:layout_marginBottom="5dp"
              app:layout_constraintTop_toBottomOf="@+id/statisctics"
              android:fontFamily="@font/avenir_medium"
              android:layout_centerVertical="true"
              android:layout_marginStart="6dp"/>
      </androidx.constraintlayout.widget.ConstraintLayout>


  </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/layoutBottomsheetpersistant"
        layout="@layout/layout_bottomsheet_alldoctors"
        android:visibility="visible"
        />
    <include
        android:id="@+id/layoutBottomsheetpersistantclinics"
        layout="@layout/layout_bottomsheet_appointements_clinics"
        android:visibility="visible"
        />
</androidx.coordinatorlayout.widget.CoordinatorLayout>