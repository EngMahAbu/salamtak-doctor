<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:padding="@dimen/_16sdp"
        android:id="@+id/add_answer_bottomsheet"
        app:behavior_hideable="true"
        android:background="@drawable/bg_edittext"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        android:layout_width="match_parent"
        android:layout_height="300dp">


    <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_questions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/avenir_black"
            android:text=""
            android:textColor="@color/black"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    <EditText
            android:id="@+id/et_answer"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_edittextinsurance"
            android:drawablePadding="5dp"
            android:drawableTint="@color/move"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:hint="@string/add_your_answers"
            android:padding="5dp"
            android:paddingStart="3dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_questions"/>


    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_btnDone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/et_answer">

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_confirm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chooselang_button"
                android:fontFamily="@font/avenir_black"
                android:text="@string/addanswer"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textAllCaps="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent=".85"/>


    </androidx.constraintlayout.widget.ConstraintLayout>



    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:indeterminateTint="@color/white"
        app:layout_constraintEnd_toEndOf="@+id/layout_btnDone"
        app:layout_constraintStart_toStartOf="@+id/layout_btnDone"
        app:layout_constraintBottom_toBottomOf="@+id/layout_btnDone"
        app:layout_constraintTop_toTopOf="@+id/layout_btnDone"
        android:visibility="gone"
        />


</androidx.constraintlayout.widget.ConstraintLayout>