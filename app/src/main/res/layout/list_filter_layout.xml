<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_200sdp">

        <View
            android:id="@+id/slide_view"
            android:layout_width="@dimen/_99sdp"
            android:layout_height="@dimen/_3sdp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:background="@color/gray_60"
            android:layout_marginTop="@dimen/_20sdp"
            android:visibility="gone"
            android:elevation="@dimen/_5sdp"/>

        <TextView
            android:id="@+id/header_title_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/_18sdp"
            android:fontFamily="@font/avenir_bold"
            android:layout_marginStart="@dimen/_12sdp"
            android:text="@string/clinics"
            android:visibility="gone"
            android:textColor="@color/title_color_black"
            android:textSize="@dimen/_14ssp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/slide_view" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/choices_rv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintTop_toBottomOf="@id/header_title_txt"
            app:layout_constraintBottom_toTopOf="@id/submit_btn"
            android:layout_margin="@dimen/_12sdp"
            />

        <TextView
            android:id="@+id/submit_btn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_44sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_margin="@dimen/_12sdp"
            android:background="@drawable/bg_btn_blue"
            android:textColor="@color/white"
            android:visibility="gone"
            android:fontFamily="@font/avenir_medium"
            android:textSize="@dimen/_12ssp"
            android:text="@string/done"
            android:gravity="center"
            />


    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>