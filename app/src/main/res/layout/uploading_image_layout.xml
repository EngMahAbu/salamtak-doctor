<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <ImageView
        android:id="@+id/iv_add_doc"
        android:layout_width="@dimen/_90sdp"
        android:layout_height="@dimen/_90sdp"
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@drawable/otp_border"
        android:scaleType="fitXY"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_add_photo"
        android:layout_width="@dimen/_25sdp"
        android:layout_height="@dimen/_25sdp"
        android:src="@drawable/ic_add"
        app:layout_constraintBottom_toBottomOf="@id/iv_add_doc"
        app:layout_constraintEnd_toEndOf="@id/iv_add_doc"
        app:layout_constraintStart_toStartOf="@id/iv_add_doc"
        app:layout_constraintTop_toTopOf="@id/iv_add_doc" />

    <ImageView
        android:id="@+id/iv_view"
        android:layout_width="@dimen/_22sdp"
        android:layout_height="@dimen/_22sdp"
        android:src="@drawable/ic_view"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@id/iv_add_doc"
        app:layout_constraintEnd_toEndOf="@id/iv_add_doc"
        app:layout_constraintStart_toStartOf="@id/iv_add_doc"
        app:layout_constraintTop_toTopOf="@id/iv_add_doc" />

    <ImageView
        android:id="@+id/iv_delete"
        android:layout_width="@dimen/_22sdp"
        android:layout_height="@dimen/_22sdp"
        android:layout_margin="@dimen/_5sdp"
        android:src="@drawable/ic_delete"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="@id/iv_add_doc"
        app:layout_constraintTop_toTopOf="@id/iv_add_doc" />

    <ImageView
        android:id="@+id/iv_new_delete"
        android:layout_width="@dimen/_22sdp"
        android:layout_height="@dimen/_22sdp"
        android:layout_margin="@dimen/_5sdp"
        android:src="@drawable/ic_delete"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@+id/iv_add_doc"
        app:layout_constraintEnd_toEndOf="@id/iv_add_doc" />


</androidx.constraintlayout.widget.ConstraintLayout>