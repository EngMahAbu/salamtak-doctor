<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        app:behavior_peekHeight="@dimen/_400sdp"
        android:orientation="vertical"
        tools:context="info.androidhive.bottomsheet.HomeActivity">

        <LinearLayout
            android:id="@+id/bottom_sheet_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/box_corner_top_white"
            android:elevation="@dimen/_5sdp"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
            <androidx.core.widget.NestedScrollView
                android:id="@+id/nested"
                android:layout_width="match_parent"
                app:layout_behavior="@string/appbar_scrolling_view_behavior"
                android:layout_height="@dimen/_328sdp"
                >
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:id="@+id/ll1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/header_title_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_18sdp"
                            android:fontFamily="@font/avenir_bold"
                            android:layout_gravity="center_horizontal"
                            android:text="@string/appointments_filter"
                            android:textColor="@color/title_color_black"
                            android:textSize="@dimen/_14ssp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/consultation_type_txt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_18sdp"
                            android:fontFamily="@font/avenir_bold"
                            android:text="@string/consultation_type"
                            android:layout_marginHorizontal="@dimen/_16sdp"
                            android:textColor="@color/title_color_black"
                            android:textSize="@dimen/_12sdp"
                            android:visibility="gone"
                            android:layout_below="@+id/header_title_txt"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/header_title_txt" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/statics_rv"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:layout_marginHorizontal="@dimen/_16sdp"
                            android:layout_below="@+id/consultation_type_txt"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/consultation_type_txt"
                            tools:itemCount="1"
                            tools:listitem="@layout/item_new_spinner" />

                        <TextView
                            android:id="@+id/header_title_txt2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/_16sdp"
                            android:layout_marginTop="@dimen/_18sdp"
                            android:fontFamily="@font/avenir_bold"
                            android:text="@string/clinics"
                            android:textColor="@color/title_color_black"
                            android:textSize="@dimen/_14ssp"
                            android:visibility="gone"
                            android:layout_below="@id/statics_rv"
                            app:layout_constraintEnd_toStartOf="@+id/end_guid_line"
                            app:layout_constraintStart_toStartOf="@id/start_guid_line"
                            app:layout_constraintTop_toBottomOf="@id/statics_rv" />
                        <LinearLayout
                            android:id="@+id/all_clinics"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="@dimen/_6sdp"
                            android:visibility="gone"
                            android:layout_marginHorizontal="@dimen/_16sdp"
                            app:layout_constraintEnd_toStartOf="@+id/end_guid_line"
                            app:layout_constraintHorizontal_bias="0.0"
                            android:layout_below="@+id/header_title_txt2"
                            app:layout_constraintStart_toStartOf="@id/start_guid_line"
                            app:layout_constraintTop_toBottomOf="@+id/header_title_txt2">

                            <RadioButton
                                android:id="@+id/radio_button_all"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:buttonTint="@color/new_themeBlue_color"
                                />

                            <TextView
                                android:id="@+id/all_clinicstxt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/avenir_medium"
                                android:gravity="center"
                                android:lines="2"
                                android:paddingStart="@dimen/_8sdp"
                                android:layout_gravity="center_vertical"
                                android:textColor="#2B2979"
                                android:textSize="@dimen/_12ssp"
                                android:text="All Clinics" />



                        </LinearLayout>


                        <!--            <include-->
                        <!--                android:id="@+id/list_layout"-->
                        <!--                layout="@layout/list_filter_layout"-->
                        <!--                android:layout_width="match_parent"-->
                        <!--                android:layout_height="wrap_content"-->
                        <!--                android:layout_marginHorizontal="@dimen/_16sdp"-->
                        <!--                android:visibility="visible"-->
                        <!--                app:layout_constraintBottom_toTopOf="@+id/apply_btn1"-->
                        <!--                app:layout_constraintEnd_toStartOf="@+id/end_guid_line"-->
                        <!--                app:layout_constraintHorizontal_bias="0.0"-->
                        <!--                app:layout_constraintStart_toStartOf="@id/start_guid_line"-->
                        <!--                app:layout_constraintTop_toBottomOf="@+id/header_title_txt2"-->
                        <!--                app:layout_constraintVertical_bias="0.0"-->
                        <!--              />-->


                        <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/choices_rv"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="@dimen/_16sdp"
                                android:layout_marginTop="@dimen/_4sdp"
                                android:orientation="vertical"
                                android:overScrollMode="never"
                                android:focusableInTouchMode="true"
                                android:nestedScrollingEnabled="false"
                                android:focusable="true"
                                android:scrollbars="none"
                                android:layout_below="@+id/all_clinics"
                                app:layout_behavior="@string/appbar_scrolling_view_behavior"
                                app:layout_constraintEnd_toStartOf="@+id/end_guid_line"
                                app:layout_constraintHorizontal_bias="0.0"
                                app:layout_constraintStart_toStartOf="@id/start_guid_line"
                                app:layout_constraintTop_toBottomOf="@+id/all_clinics"
                                app:layout_constraintVertical_bias="1.0"
                                android:layout_marginBottom="@dimen/_12sdp"
                                tools:listitem="@layout/item_home_clinic"/>
                        <include
                            android:id="@+id/choose_layout"
                            layout="@layout/select_filter_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />


                        <include
                            android:id="@+id/list_layout"
                            layout="@layout/list_filter_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/choose_layout" />

                        <include
                            android:id="@+id/date_layout"
                            layout="@layout/bottom_sheet_dates_filter"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </LinearLayout>


                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/start_guid_line"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.05" />

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/end_guid_line"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.95" />
                </RelativeLayout>
            </androidx.core.widget.NestedScrollView>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/apply_btn1"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:layout_margin="@dimen/_12sdp"
                android:backgroundTint="@color/new_themeBlue_color"
                app:cornerRadius="@dimen/_6sdp"
                android:fontFamily="@font/avenir_medium"
                android:gravity="center"
                android:text="@string/dones"
                android:visibility="visible"
                android:textColor="@color/white"
                android:textSize="@dimen/_10ssp"
                android:layout_below="@+id/nested"
                android:layout_alignParentBottom="true"
                 />
        </LinearLayout>




    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</layout>

